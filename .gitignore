/ClassDiagram.cd
/Meshes
/Textures
# Скачанные исходники ассетов (архивы Poly Haven и других): из них сценарии Tools/ собирают данные
/DownloadResources
/cmake-build-*/
# Локальные настройки инструментов: Claude Code (разрешения, хуки с путями машины) и проект CLion
/.claude/
/.idea/
__pycache__/
# Кэш DXIL шейдеров и библиотеки пайплайнов (D3D/ShaderCompiler.h, DMD3D::loadPipelineLibrary)
/cache/

# graphify: граф знаний по репозиторию (перестраивается /graphify)
/graphify-out/
# Лог запуска — каждый запуск пишет его заново (LOG, src/Logger) — и снимки клавишей P (DMGraphics::saveScreenshot)
/log.txt
/screenshot*.jpg
# Раскладка окон редактора (строится кодом, Window > Reset layout) и прежний файл ImGui
/imgui_editor.ini
/imgui.ini
