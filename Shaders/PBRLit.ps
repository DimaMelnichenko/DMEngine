////////////////////////////////////////////////////////////////////////////////
// PBR metallic/roughness (как Default Lit в UE5 и материал glTF 2.0), класс материала PBR (PBRMaterial)
////////////////////////////////////////////////////////////////////////////////

#include "slots.h"
#include "common.vs"
#include "lighting.sh"
#include "ambient_occlusion.sh"
#include "depth_only.sh"
#include "pbr_material_constants.h"
#include "lod_dither.sh"
#include "bindless.sh"
#ifdef TERRAIN_BLEND
#include "terrain_blend.sh"
#endif

// Не заданная текстура — белая 1×1 (для Normal — плоская нормаль), так что работают одни множители
DM_SRV( Texture2D, g_texBaseColor, 0 );         // sRGB, альфа — прозрачность
DM_SRV( Texture2D, g_texNormal, 1 );            // касательное пространство, линейная
DM_SRV( Texture2D, g_texMetallicRoughness, 2 ); // G — roughness, B — metallic (упаковка glTF), линейная
DM_SRV( Texture2D, g_texOcclusion, 3 );         // R — затенение окружающего света, линейная
DM_SRV( Texture2D, g_texEmissive, 4 );          // sRGB
DM_SRV( Texture2D, g_texDiffuseTransmissionColor, 5 );	// sRGB: цвет света, прошедшего насквозь

struct PixelInputType
{
	float4 position : SV_POSITION;
	float2 tex : TEXCOORD0;
	float3 normal : NORMAL;
	float3 tangent : TANGENT0;
	float3 binormal : BINORMAL0;
	float3 worldPosition : TEXCOORD1;
	float4 ground : TEXCOORD3;			// цвет земли у растения расстановки и его доля (LightShader.vs, scatter_ground.sh)
	float groundBrightness : TEXCOORD4;	// множитель своего цвета
#ifdef LOD_DITHER
	nointerpolation float lodDither : TEXCOORD2;
#endif
	bool isFrontFace : SV_IsFrontFace;
};

float3 surfaceNormal( PixelInputType input )
{
	// Задняя грань двусторонней геометрии (карточки без отсечения граней) освещается как передняя; у листвы с нормалью кроны
	// (CrownNormalBlend, LightShader.vs) обе стороны смотрят из кроны наружу — не переворачивается
	float3 normal = input.isFrontFace || g_crownNormalBlend > 0.0f ? input.normal : -input.normal;

	// Z — из X и Y (нормаль карты единичной длины): у карт в BC5 (Textures.compression = normalmap) хранятся только они
	float3 n;
	n.xy = g_texNormal.Sample( g_SamplerAnisotropicWrap, input.tex ).rg * 2.0f - 1.0f;
	n.z = sqrt( saturate( 1.0f - dot( n.xy, n.xy ) ) );
	n.xy *= g_normalScale;
	// Бинормаль меша — направление роста v, то есть вниз по картинке (соглашение DirectX)
	n.y = g_normalGreenUp > 0.5f ? -n.y : n.y;

	float3x3 tbn = float3x3( normalize( input.tangent ), normalize( input.binormal ), normalize( normal ) );
	return normalize( mul( n, tbn ) );
}

float4 main( PixelInputType input ) : SV_TARGET
{
#ifdef LOD_DITHER
	// Экземпляр в полосе смены LOD (вариант, который PBRMaterial собирает сам): своя доля пикселей у каждого из двух LOD
	clipLodTransition( input.position.xy, input.lodDither );
#endif

	float4 baseColor = g_texBaseColor.Sample( g_SamplerAnisotropicWrap, input.tex ) * g_baseColorFactor;

#ifdef ALPHA_MASK
	// Вариант для AlphaMode MASK (Masked в UE) — PBRMaterial собирает его сам. В непрозрачном варианте отсечения нет:
	// шейдер с clip() отключает раннюю проверку глубины
	clip( baseColor.a - g_alphaCutoff );
#endif

	float4 metallicRoughness = g_texMetallicRoughness.Sample( g_SamplerAnisotropicWrap, input.tex );

	Surface surface;
	surface.position = input.worldPosition;
	surface.normal = surfaceNormal( input );
	surface.geometricNormal = normalize( input.isFrontFace || g_crownNormalBlend > 0.0f ? input.normal : -input.normal );
	// Растение расстановки: у корня — цвет земли под ним, вдали — и выше (у остальных доля 0, множитель 1)
	surface.baseColor = lerp( baseColor.rgb * input.groundBrightness, input.ground.rgb, input.ground.a );
	surface.metallic = saturate( g_metallic * metallicRoughness.b );
	surface.specular = g_specularFactor;
	surface.roughness = g_roughness * metallicRoughness.g;
	surface.occlusion = lerp( 1.0f, g_texOcclusion.Sample( g_SamplerAnisotropicWrap, input.tex ).r, g_occlusionStrength );
	surface.microShadows = 0.0f;
	surface.selfShadow = 1.0f;
	surface.screenOcclusion = screenAmbientOcclusion( input.position.xy, surface.position );
	surface.emissive = g_texEmissive.Sample( g_SamplerAnisotropicWrap, input.tex ).rgb * g_emissiveFactor;
	surface.transmission = saturate( g_diffuseTransmissionFactor );
	surface.transmissionColor = 0.0f;
	[branch] if( surface.transmission > 0.0f )
		surface.transmissionColor = g_texDiffuseTransmissionColor.Sample( g_SamplerAnisotropicWrap, input.tex ).rgb *
									g_diffuseTransmissionColorFactor;
	surface.transmissionForward = g_transmissionForward;
	surface.transmissionForwardRoughness = g_transmissionForwardRoughness;

#ifdef TERRAIN_BLEND
	// У земли — в материал террейна (TerrainBlendHeight; только у уровня с террейном)
	const float3 positionDX = ddx( input.worldPosition );
	const float3 positionDY = ddy( input.worldPosition );
	[branch] if( cb_terrain.x > 0.0f )
		blendWithTerrain( surface, positionDX, positionDY, g_terrainBlendHeight, g_terrainBlendContrast );
#endif

	// Линейный HDR: экспозиция и тонмаппинг — в постобработке (Shaders/tonemap.ps). Альфа нужна только
	// полупрозрачному (AlphaMode BLEND): у непрозрачных блендинг выключен
	return float4( evaluateLighting( surface ), baseColor.a );
}

// Запекание импостера (ImpostorMaterial::bake, как ImpostorBaker в UE): вид модели с одного направления в три цели —
// цвет и покрытие (альфа 1 там, где модель есть; цель sRGB), нормаль в координатах модели (при запекании мировая
// матрица — единичная) с долей пропускания в альфе и глубина поверхности для смещения глубины импостера. Освещение — у
// импостера в кадре (Shaders/impostor.ps)
struct BakeOutput
{
	float4 color : SV_Target0;
	float4 normal : SV_Target1;
	float depth : SV_Target2;
};

BakeOutput mainBake( PixelInputType input )
{
	float4 baseColor = g_texBaseColor.Sample( g_SamplerAnisotropicWrap, input.tex ) * g_baseColorFactor;
#ifdef ALPHA_MASK
	clip( baseColor.a - g_alphaCutoff );
#endif
	BakeOutput output;
	output.color = float4( baseColor.rgb, 1.0f );
	output.normal = float4( surfaceNormal( input ) * 0.5f + 0.5f, saturate( g_diffuseTransmissionFactor ) );
	// Ортография кадра на сферу модели (ImpostorMaterial::frameView): глубина 0,5 — плоскость через центр, ± 0,25 — радиус
	// к камере и от неё; в цель — смещение к камере в долях радиуса × 0,5 + 0,5
	output.depth = saturate( 2.0f * input.position.z - 0.5f );
	return output;
}

// Глубина теней и depth prepass: только отсечение, цвета нет (у проходов глубины нет цели цвета) — по альфе у
// AlphaMode MASK (ALPHA_MASK) и дизерингом в полосе смены LOD (LOD_DITHER). Непрозрачные вне перехода рисуют глубину
// без пиксельного шейдера. Вход — от вершинного шейдера «только глубина» (DEPTH_ONLY)
void mainDepth( DepthOnlyVertexOutput input )
{
#ifdef LOD_DITHER
	clipLodTransition( input.position.xy, input.lodDither );
#endif
#ifdef ALPHA_MASK
	clip( g_texBaseColor.Sample( g_SamplerAnisotropicWrap, input.tex ).a * g_baseColorFactor.a - g_alphaCutoff );
#endif
}
