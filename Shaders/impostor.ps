////////////////////////////////////////////////////////////////////////////////
// Импостер (ImpostorMaterial, Shaders/impostor.sh): три кадра смешиваются по весам — цвет и покрытие, нормаль модели
// (в мир — поворотом экземпляра), доля пропускания и глубина поверхности: пиксель — точка запечённой поверхности, а не
// карточки (pixel depth offset), и освещается, затеняется и пишет глубину она — дерево не уходит в склон, крона затеняет
// себя в каскадах. Освещение — общая функция evaluateLighting, как у материалов: свет, тень, небо, воздушная перспектива.
// С ALPHA_MASK — отсечение по покрытию и глубина поверхности (без depth prepass); без него — после prepass, в проходе
// opaqueDepthRead: глубину уже записал mainDepth, пиксель освещается, только если записана его глубина (глубина сцены,
// SLOT_SCENE_DEPTH), — закрытый соседней елью отбрасывается до освещения; отсечение по покрытию и дизеринг — как в
// prepass. С LOD_DITHER — доля пикселей смены LOD.
// mainDepth — тени и depth prepass.
// С IMPOSTOR_FLAT — плоский импостер (трава без тени, ImpostorMaterial::flat): точка и глубина — самой карточки, без
// смещения глубины; после prepass — обычный проход opaque с тестом EQUAL, без чтения глубины сцены.
// Самотень кроны (не у плоского) — тень солнца от самой модели по её же кадрам, impostorSelfShadow
////////////////////////////////////////////////////////////////////////////////

#include "slots.h"
#include "common.vs"
#include "lighting.sh"
#include "ambient_occlusion.sh"
#include "lod_dither.sh"
#include "bindless.sh"
#include "impostor.sh"
#include "scatter_ground.sh"

DM_SRV( Texture2DArray, g_impostorColor, 0 );	// sRGB: цвет и покрытие, срез — кадр
DM_SRV( Texture2DArray, g_impostorNormal, 1 );	// нормаль модели × 0,5 + 0,5 и доля пропускания
// R16G16: R — смещение поверхности к камере кадра от плоскости через центр, радиусов × 0,5 + 0,5; G — доля направлений
// полусферы, откуда точку видно (затенение окружающего света внутри кроны)
DM_SRV( Texture2DArray, g_impostorDepth, 2 );
#ifndef ALPHA_MASK
DM_SRV( Texture2D<float>, g_sceneDepth, SLOT_SCENE_DEPTH );
#endif

float4 sampleFrames( Texture2DArray frames, ImpostorPixelInput input )
{
	return frames.Sample( g_SamplerLinearClamp, float3( input.frameUV01.xy, input.frames.x ) ) * input.weights.x +
		   frames.Sample( g_SamplerLinearClamp, float3( input.frameUV01.zw, input.frames.y ) ) * input.weights.y +
		   frames.Sample( g_SamplerLinearClamp, float3( input.frameUV2, input.frames.z ) ) * input.weights.z;
}

// Точка поверхности под пикселем: точка карточки в плоскости через центр, сдвинутая вдоль направления на зрителя до
// запечённой глубины кадров. precise — одна и та же у depth prepass и прохода цвета (сравнение с глубиной сцены)
float3 impostorSurface( ImpostorPixelInput input )
{
	precise const float stored = sampleFrames( g_impostorDepth, input ).x;
	precise const float3 position = input.worldPosition + input.viewer.xyz * ( ( stored * 2.0f - 1.0f ) * input.viewer.w - input.planeOffset );
	return position;
}

#ifndef IMPOSTOR_FLAT
// Самотень кроны: тень солнца (луны — у источника теней) от самой модели. Каскады теней дают её только ближе дистанции
// теней (200 м) и с силой, зависящей от их текселя, дальше крона освещена со всех сторон и бледна. Здесь — по кадрам:
// точка поверхности проецируется в три кадра вокруг направления на солнце, как модель в кадре со стороны солнца; глубже
// запечённой там поверхности — за кроной, и свет гасит покрытие кадра в этом месте (редкая крона пропускает часть).
// Выборки — по мипу impostorShadowMip: тень мягкая, без шума отдельных хвоинок. 1 — не в тени
static const float impostorShadowMip = 1.0f;
static const float impostorShadowBias = 0.03f;		// радиусов сферы: поверхность, обращённая к солнцу, не затеняет себя
static const float impostorShadowSoftness = 0.1f;	// радиусов сферы: от «на поверхности» до полной тени

float impostorSelfShadow( ImpostorPixelInput input, float3 position )
{
	const float strength = g_impostorShade.z;
	[branch] if( strength <= 0.0f || g_shadowSunIndex < 0 )
		return 1.0f;
	const float4 inverse = float4( -input.rotation.xyz, input.rotation.w );
	const float3 toSun = impostorRotate( -g_lights[g_shadowSunIndex].direction, inverse );
	const float3 offset = impostorRotate( position - input.center.xyz, inverse ) / input.center.w;
	uint2 frames[3];
	float3 weights;
	impostorFrameTriangle( toSun, frames[0], frames[1], frames[2], weights );
	float occluded = 0.0f;
	[unroll] for( uint i = 0; i < 3; ++i )
	{
		const float3 uvw = float3( impostorFrameUV( frames[i], offset ), frames[i].y * g_impostorFrames + frames[i].x );
		// Запечённая глубина и глубина точки — к камере кадра от плоскости через центр, в радиусах
		const float stored = g_impostorDepth.SampleLevel( g_SamplerLinearClamp, uvw, impostorShadowMip ).x * 2.0f - 1.0f;
		const float depth = dot( offset, impostorFrameDirection( frames[i] ) ) / g_impostorBounds.w;
		const float coverage = saturate( g_impostorColor.SampleLevel( g_SamplerLinearClamp, uvw, impostorShadowMip ).a );
		occluded += weights[i] * coverage * saturate( ( stored - depth - impostorShadowBias ) / impostorShadowSoftness );
	}
	return 1.0f - strength * occluded;
}
#endif

// Глубина точки поверхности (обратная): не ближе растеризованной карточки — SV_DepthLessEqual, при обратной глубине
// только дальше, ранний тест остаётся
float impostorDepth( ImpostorPixelInput input, float3 position )
{
	precise const float4 clipPosition = mul( float4( position, 1.0f ), cb_viewProjectionMatrix );
	precise const float depth = min( clipPosition.z / clipPosition.w, input.position.z );
	return depth;
}

#if defined(ALPHA_MASK) && !defined(IMPOSTOR_FLAT)
float4 main( ImpostorPixelInput input, out float depth : SV_DepthLessEqual ) : SV_TARGET
#else
float4 main( ImpostorPixelInput input ) : SV_TARGET
#endif
{
#ifdef LOD_DITHER
	clipLodTransition( input.position.xy, input.lodDither );
#endif
#ifdef IMPOSTOR_FLAT
	// Без prepass — отсечение по покрытию; после него пиксель уже выбран тестом глубины EQUAL
	const float4 color = sampleFrames( g_impostorColor, input );
#ifdef ALPHA_MASK
	clip( color.a - g_impostorAlphaCutoff );
#endif
	const float3 position = input.worldPosition;
#elif defined(ALPHA_MASK)
	const float4 color = sampleFrames( g_impostorColor, input );
	clip( color.a - g_impostorAlphaCutoff );
	const float3 position = impostorSurface( input );
	depth = impostorDepth( input, position );
#else
	// Видимость — до выборки цвета и освещения: пиксель наш, только если prepass записал его глубину; иначе там другая
	// поверхность (соседняя ель, склон) или прозрачная часть карточки (prepass её отсёк, а растёкшаяся глубина кадров —
	// ближе земли за ней). Сначала одной выборкой: записанное дальше задней границы сферы (земля, небо, дальние ели);
	// затем глубина поверхности — равна записанной с допуском в долю глубины (у обратной глубины она ~ 1 / расстояние)
	const float sceneDepth = g_sceneDepth[uint2( input.position.xy )];
	const float4 backPosition = mul( float4( input.worldPosition - input.viewer.xyz * ( input.viewer.w + input.planeOffset ), 1.0f ), cb_viewProjectionMatrix );
	if( sceneDepth < backPosition.z / backPosition.w )
		discard;
	const float3 position = impostorSurface( input );
	if( abs( impostorDepth( input, position ) - sceneDepth ) > sceneDepth * 1e-4f )
		discard;
	// И покрытие, как в prepass: у подножия растёкшаяся глубина прозрачного текселя может совпасть с землёй
	const float4 color = sampleFrames( g_impostorColor, input );
	clip( color.a - g_impostorAlphaCutoff );
#endif
	const float4 packed = sampleFrames( g_impostorNormal, input );
	const float3 normal = normalize( impostorRotate( normalize( packed.xyz * 2.0f - 1.0f ), input.rotation ) );
	// Затемнение низа — по высоте точки поверхности над корнем экземпляра: у травы вдали без тени
	const float height = saturate( ( position.y - input.heightRange.x ) * input.heightRange.y );
	// Цвет земли под экземпляром — как у модели (LightShader.vs): по высоте точки поверхности над корнем
	float4 ground;
	float groundBrightness;
	scatterGround( input.ground, max( position.y - input.heightRange.x, 0.0f ), ground, groundBrightness );
	const float3 baseColor = lerp( color.rgb * lerp( 1.0f - g_impostorShade.x, 1.0f, height ) * groundBrightness, ground.rgb, ground.a );

	Surface surface;
	surface.position = position;
	surface.normal = normal;
	surface.geometricNormal = normal;
	surface.baseColor = baseColor;
	surface.metallic = 0.0f;
	surface.specular = 1.0f;
	surface.roughness = g_impostorRoughness;
	surface.occlusion = lerp( 1.0f, sampleFrames( g_impostorDepth, input ).y, g_impostorOcclusion );
	surface.microShadows = 0.0f;
#ifdef IMPOSTOR_FLAT
	surface.selfShadow = 1.0f;
#else
	surface.selfShadow = impostorSelfShadow( input, position );
#endif
	surface.screenOcclusion = screenAmbientOcclusion( input.position.xy, position );
	surface.emissive = 0.0f;
	surface.transmission = saturate( packed.w * g_impostorTransmission.w );
	surface.transmissionColor = baseColor * g_impostorTransmission.xyz;
	surface.transmissionForward = g_impostorTransmissionForward.x;
	surface.transmissionForwardRoughness = g_impostorTransmissionForward.y;
	return float4( evaluateLighting( surface ), 1.0f );
}

// Тени и depth prepass: глубина — точки поверхности (у каскада — вдоль света); у плоского — карточки
#ifdef IMPOSTOR_FLAT
void mainDepth( ImpostorPixelInput input )
#else
void mainDepth( ImpostorPixelInput input, out float depth : SV_DepthLessEqual )
#endif
{
#ifdef LOD_DITHER
	clipLodTransition( input.position.xy, input.lodDither );
#endif
#ifdef IMPOSTOR_FLAT
	// Покрытие — одним кадром из трёх, выбранным для пикселя по весам порогом дизеринга: одна выборка вместо трёх (у травы
	// вдали — десятки почти прозрачных карточек на пиксель, prepass упирается в них), переход между кадрами — долей
	// пикселей, без скачка формы. Проход цвета после prepass покрытие не проверяет (тест EQUAL), поэтому оно — только отсюда.
	// Шум сдвинут относительно порога смены LOD: иначе в полосе перехода кадр выбирали бы только оставшиеся пиксели
	const float pick = lodDitherThreshold( input.position.xy + float2( 13.0f, 7.0f ) );
	const float3 frame = pick < input.weights.x ? float3( input.frameUV01.xy, input.frames.x ) :
						 pick < input.weights.x + input.weights.y ? float3( input.frameUV01.zw, input.frames.y ) :
						 float3( input.frameUV2, input.frames.z );
	clip( g_impostorColor.Sample( g_SamplerLinearClamp, frame ).a - g_impostorAlphaCutoff );
#else
	clip( sampleFrames( g_impostorColor, input ).a - g_impostorAlphaCutoff );
	depth = impostorDepth( input, impostorSurface( input ) );
#endif
}
