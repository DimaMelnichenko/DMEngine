////////////////////////////////////////////////////////////////////////////////
// Материал дальних гор вокруг карты (FarTerrain): нормаль — по их высоте (far_terrain.sh), веса слоёв — правила по высоте и
// уклону (скала, осыпи, снег, луг, трава долины) и ледники наших дней, у карты — её слои; смесь слоёв — terrain_material.sh,
// как у рельефа карты. Лес издали — тоном земли по плотности леса гор (дальше кольца деревьев), голый лёд — слой снега с оттенком льда,
// морены — слой осыпей, трещины — тёмные полосы поперёк течения льда
////////////////////////////////////////////////////////////////////////////////

#include "lighting.sh"
#include "ambient_occlusion.sh"
// cdlod.sh — раньше ядра материала: константы слоёв — из cbuffer террейна
#include "cdlod.sh"
#include "terrain_material.sh"
#include "far_terrain.sh"

// Плотность леса гор (FarTerrain::bakeForestDensity, far_forest_density.cs) — ресурс сцены: тон леса — та же плотность, что у
// деревьев слоя far_forest, без своих правил
DM_SRV( Texture2D<float>, g_farForestTone, SLOT_FAR_FOREST );

// Ширина кроны — эта доля высоты дерева (ель: 5–7 м при 20 м)
static const float crownWidthShare = 0.3f;

float forestDensity( float2 worldXZ )
{
	return g_farForestTone.SampleLevel( g_SamplerLinearClamp, farHeightMapUV( worldXZ ), 0.0f );
}

// Тень леса на земле гор дальше дистанции теней — там её не дают ни каскады, ни дальний каскад (он — над картой), а деревья
// кольца far_forest стоят на светлой земле. Не по деревьям, а по плотности леса (булева модель покрытия, как доля затенённой
// земли под пологом): тень дерева — крона и полоса за ней длиной L = высота · ctg высоты солнца; земля в тени, если хоть
// одно дерево на отрезке L к солнцу её закрывает — доля освещённой земли exp( −c · ( 1 + L / D ) ), c — доля земли под
// кронами на этом отрезке (forestShadow × плотность), D — ширина кроны. Опушка поляны со стороны солнца — в тени леса,
// дальняя — на свету. sky — доля неба над землёй под кронами (полог закрывает половину неба над собой)
float forestShadow( float3 position, float3 toSun, out float sky )
{
	sky = 1.0f;
	[branch] if( g_forestShadow <= 0.0f || toSun.y <= 0.0f )
		return 1.0f;
	const float horizontal = length( toSun.xz );
	const float shadowLength = g_forestHeight * horizontal / max( toSun.y, 0.05f );
	const float2 along = horizontal > 1e-4f ? toSun.xz / horizontal : 0.0f;
	float cover = 0.0f;
	[unroll] for( uint k = 0; k < 4; ++k )
		cover += forestDensity( position.xz + along * shadowLength * ( k + 0.5f ) * 0.25f );
	cover *= 0.25f * g_forestShadow;
	sky = 1.0f - 0.5f * g_forestShadow * forestDensity( position.xz );
	return exp( -cover * ( 1.0f + shadowLength / ( crownWidthShare * g_forestHeight ) ) );
}

float4 main( PixelInputType input ) : SV_TARGET
{
	const float3 position = input.worldPosition;
	const float3 positionDX = ddx( position );
	const float3 positionDY = ddy( position );
	const float footprint = max( length( positionDX.xz ), length( positionDY.xz ) );

	// Нормаль — разностями через пиксель, но не мельче полутекселя карты гор: их билинейные грани не видны сеткой
	const float blend = farBlend( position.xz );
	const float3 normal = farNormal( position.xz, max( footprint, lerp( g_texelSize, 0.5f * g_texelSize * exp2( g_farMipBias ), blend ) ) );
	const float3 projection = projectionWeights( normal );

	float weights[maxLayers];
	float forest;
	float bareIce;
	float glacier;
	const FarGlacier ice = farGlacier( position.xz );
	farRuleWeights( position, normal, ice, weights, forest, bareIce, glacier );
	forest = g_farForestTone.SampleLevel( g_SamplerLinearClamp, farHeightMapUV( position.xz ), 0.0f );
	// У карты — её слои (край splat-карты продолжен наружу), к g_farMaterialBlend — правила
	const float rules = smoothstep( 0.0f, max( g_farMaterialBlend, 1e-3f ), distanceToMap( position.xz ) );
	const float2 uv = heightMapUV( position.xz );
	float painted[maxLayers];
	splatMapWeights( uv, painted );
	[unroll] for( uint layer = 0; layer < maxLayers; ++layer )
		weights[layer] = lerp( painted[layer], weights[layer], rules );
	forest *= rules;
	bareIce *= rules;
	// Ближе кольца деревьев на горах (слой расстановки far_forest) лес — деревьями: тон — дальше, навстречу их исчезанию
	[branch] if( g_forestRing.x > 0.0f )
		forest *= smoothstep( g_forestRing.x - g_forestRing.y, g_forestRing.x, length( position - cb_cameraPosition ) );
	// Трещины — где течение льда круче (ледопады; уклон усреднён по льду — не по мелким неровностям поверхности), и под снегом:
	// тень в трещине видна сквозь снежные мосты
	const float crevassed = glacier * rules * slopeShare( g_crevasseSlope, rsqrt( 1.0f + dot( ice.downhill, ice.downhill ) ) );

	// Вдали — третий масштаб текстур («Macro texture scale» к дальнему): повтор дальнего за километры складывается в сетку
	// бугорков, а в крупном рисунок скал и снега остаётся. Обе выборки — только в полосе «Macro distance»
	const float2 macroRange = float2( g_macroDistance.x, max( g_macroDistance.y, g_macroDistance.x + 1.0f ) );
	const float macro = smoothstep( macroRange.x, macroRange.y, length( position - cb_cameraPosition ) );
	TerrainLayerMix mixed = (TerrainLayerMix)0;
	[branch] if( macro < 1.0f )
		mixed = mixTerrainLayers( weights, farTextureShare( position ), 1.0f, position, positionDX, positionDY, projection );
	[branch] if( macro > 0.0f )
	{
		const TerrainLayerMix large = mixTerrainLayers( weights, 1.0f, g_macroTextureScale, position, positionDX, positionDY, projection );
		mixed.albedo = lerp( mixed.albedo, large.albedo, macro );
		mixed.detail = lerp( mixed.detail, large.detail, macro );
		mixed.roughness = lerp( mixed.roughness, large.roughness, macro );
		mixed.occlusion = lerp( mixed.occlusion, large.occlusion, macro );
	}

	Surface surface;
	surface.transmission = 0.0f;
	surface.transmissionColor = 0.0f;
	surface.transmissionForward = 0.0f;
	surface.transmissionForwardRoughness = 1.0f;
	surface.position = position;
	// Лес — гладкий тёмный тон без рисунка слоёв
	surface.normal = normalize( normal + mixed.detail * ( 1.0f - forest ) );
	surface.geometricNormal = normal;
	// Пятна яркости земли (тексели 13 и 40 м, как у карты) — только вблизи: вдали их мип 0 дал бы решётку
	float3 albedo = mixed.albedo * lerp( 1.0f, g_glacierIceTint, bareIce );
	[branch] if( crevassed > 0.0f )
		albedo = lerp( albedo, g_crevasseColor, crevassed * farCrevasses( position.xz, ice.downhill, footprint ) );
	surface.baseColor = lerp( albedo * lerp( terrainBrightness( position.xz ), 1.0f, macro ), g_forestColor, forest );
	surface.metallic = 0.0f;
	surface.specular = 1.0f;
	surface.roughness = lerp( mixed.roughness, 0.9f, forest );
	surface.occlusion = saturate( mixed.occlusion );
	surface.microShadows = terrainLayers().microShadows;
	surface.selfShadow = 1.0f;
	// Тень леса на земле — дальше дистанции теней (ближе её дают каскады) и там, где видна земля, а не тон леса (он сам —
	// полог с его тенями)
	[branch] if( g_shadowSunIndex >= 0 )
	{
		const float canopy = farShadowFade( viewDepthOf( position ) ) * ( 1.0f - forest );
		[branch] if( canopy > 0.0f )
		{
			float sky;
			const float lit = forestShadow( position, -g_lights[g_shadowSunIndex].direction, sky );
			surface.selfShadow = lerp( 1.0f, lit, canopy );
			surface.occlusion *= lerp( 1.0f, sky, canopy );
		}
	}
	surface.screenOcclusion = screenAmbientOcclusion( input.position.xy, surface.position );
	surface.emissive = 0.0f;

	// Линейный HDR: экспозиция и тонмаппинг — в постобработке (Shaders/tonemap.ps)
	return float4( evaluateLighting( surface ), 1.0f );
}
