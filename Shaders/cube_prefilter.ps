////////////////////////////////////////////////////////////////////////////////
// Префильтр отражений (split-sum, Karis 2013): грань g_face мипа с шероховатостью g_roughness — cubemap окружения
// (неба, панорамы или карты отражений места), свёрнутый с распределением GGX. Выборка по важности берёт мип исходника по
// плотности выборок (filtered importance sampling, Křivánek и Colbert 2008), чтобы не было шума при малом числе выборок.
// Класс CubePrefilter
////////////////////////////////////////////////////////////////////////////////

#include "slots.h"
#include "samplers.sh"
#include "cubemap.sh"
#include "ibl_sampling.sh"
#include "bindless.sh"

#include "cube_prefilter_constants.h"

DM_SRV( TextureCube, g_sky, 0 );

struct PixelInputType
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
};

float4 main( PixelInputType input ) : SV_TARGET
{
	// Направление взгляда совпадает с нормалью и отражением (приближение split-sum)
	float3 n = cubeDirection( g_face, input.uv );
	// Альфа — покрытие (у карты отражений места: доля сцены, а не неба; цвет уже умножен на неё) — усредняется так же
	if( g_roughness <= 0.0f )
	{
		const float4 texel = g_sky.SampleLevel( g_SamplerLinearClamp, n, 0.0f );
		return float4( texel.rgb * g_outputScale, texel.a );
	}

	const uint sampleCount = 128;
	const float alpha = g_roughness * g_roughness;
	const float texelSolidAngle = 4.0f * cubemapPi / ( 6.0f * g_sourceSize * g_sourceSize );

	float4 sum = 0.0f;
	float weight = 0.0f;
	[loop] for( uint i = 0; i < sampleCount; ++i )
	{
		float3 h = importanceSampleGGX( hammersley( i, sampleCount ), alpha, n );
		float3 l = 2.0f * dot( n, h ) * h - n;
		float NoL = dot( n, l );
		if( NoL <= 0.0f )
			continue;

		// pdf выборки направления l: D·(n·h) / (4·(v·h)), при v = n — D / 4
		float NoH = saturate( dot( n, h ) );
		float d = NoH * NoH * ( alpha * alpha - 1.0f ) + 1.0f;
		float pdf = alpha * alpha / ( cubemapPi * d * d ) * 0.25f;
		float sampleSolidAngle = 1.0f / ( sampleCount * pdf + 1e-4f );
		float mip = max( 0.5f * log2( sampleSolidAngle / texelSolidAngle ) + 1.0f, 0.0f );

		sum += g_sky.SampleLevel( g_SamplerLinearClamp, l, mip ) * NoL;
		weight += NoL;
	}

	const float4 average = sum / max( weight, 1e-4f );
	return float4( average.rgb * g_outputScale, average.a );
}
