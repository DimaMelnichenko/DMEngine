////////////////////////////////////////////////////////////////////////////////
// Материал террейна CDLOD (TerrainMaterial). Нормаль рельефа считается по карте высот, веса до восьми слоёв
// берутся из каналов splat-карты — массива из двух RGBA, как weightmap в UE Landscape, у русел — из детального слоя весов,
// под водой — дно по глубине. Смесь слоёв по весам — terrain_material.sh (общее с дальними горами): четыре самых весомых,
// triplanar, крупный масштаб вдали, смешивание по высоте. AO слоёв гасит свет неба в щелях между камнями и даёт микротени
// прямого света (lighting.sh)
////////////////////////////////////////////////////////////////////////////////

#include "lighting.sh"
#include "ambient_occlusion.sh"
#include "cdlod.sh"
#include "bindless.sh"
#include "water.sh"
#include "wind_field.sh"
#include "terrain_layers.sh"
#include "terrain_material.sh"

DM_SRV( Texture2D, g_paintMask, 7 );	// маска — цель кисти или места звука (g_paintPreview maxLayers + 1), в UV карты высот


// Доля диапазона: 0 при from, 1 при to (в любую сторону), плавно; from = to — ступень
float ramp( float from, float to, float x )
{
	const float range = to - from;
	const float t = abs( range ) > 1e-6f ? saturate( ( x - from ) / range ) : ( x >= from ? 1.0f : 0.0f );
	return t * t * ( 3.0f - 2.0f * t );
}

// Наносы на дне озера (правила «Water beds»): x — доля дресвы, y — ила, остальное — галька. У нижних озёр (уровень воды
// level ниже g_lakeSedimentLevel) волны не вымывают мелочь глубже уреза: галька у берега, глубже дресва, ещё глубже ил.
// Как TerrainDetailSplat (CPU, детальный слой весов у русел); слоя нет — его доля гальке (ила нет — дресве)
float2 lakeBedShares( float depth, float level )
{
	if( g_lakeGravelLayer < 0 )
		return 0.0f;
	const float sediment = ramp( g_lakeSedimentLevel.x, g_lakeSedimentLevel.y, level );
	const float gravel = sediment * ramp( g_lakeBedDepths.x, g_lakeBedDepths.y, depth );
	const float silt = g_lakeSiltLayer >= 0 ? min( sediment * ramp( g_lakeBedDepths.z, g_lakeBedDepths.w, depth ), gravel ) : 0.0f;
	return float2( gravel - silt, silt );
}

float4 main( PixelInputType input ) : SV_TARGET
{
	// Текстуры, веса и проекции — по точке без смещения (дисплейсмент сдвигает вершины вдоль нормали, текстура остаётся на
	// месте, как UV у Nanite displacement в UE); свет, тень и туман — по смещённой (surface.position)
	float3 position = input.basePosition;
	float3 positionDX = ddx( position );
	float3 positionDY = ddy( position );

	float footprint = max( length( positionDX.xz ), length( positionDY.xz ) );
	float3 normal = terrainNormal( position.xz, max( log2( footprint / g_texelSize ), 0.0f ) );
	// У русла — нормаль детальной плитки (U-ложе, бровки): разности через полпикселя, но не мельче её шага; вдали (пиксель
	// крупнее двух текселей карты высот) — к нормали карты, к четырём — только она
	float unused;
	[branch] if( footprint < 4.0f * g_texelSize && sampleTerrainDetail( position.xz, g_detailTile, unused ) )
	{
		const float detailShare = saturate( 2.0f - footprint / ( 2.0f * g_texelSize ) );
		normal = normalize( lerp( normal, fineNormal( position.xz, max( 0.5f * footprint, 0.25f * g_texelSize ) ), detailShare ) );
	}
	float3 projection = projectionWeights( normal );

	float weights[maxLayers];
	[unroll] for( uint s = 0; s < splatSlices; ++s )
	{
		const float4 slice = g_splatMap.Sample( g_SamplerLinearClamp, float3( input.uv, s ) );
		[unroll] for( uint c = 0; c < 4; ++c )
			weights[4 * s + c] = slice[c];
	}
	// У русел — детальный слой весов (0,25 м: галька по врезу и дно под водой, мокрость), пока пиксель не крупнее двух
	// текселей карты высот, к четырём — splat-карта 1 м (в ней галька русел по клеткам), как у нормали. Мипов у плиток нет,
	// а в мипах splat-карты узкое русло растворяется в траве: веса меньше соседних слоёв проигрывают им и при смешивании по
	// высоте
	float detailShare = 0.0f;
	float bakedWetness = 0.0f;
	float fine[maxLayers];
	float4 fineExtra = 0.0f;
	[branch] if( footprint < 4.0f * g_texelSize && sampleSplatDetail( position.xz, fine, fineExtra ) )
	{
		detailShare = saturate( 2.0f - footprint / ( 2.0f * g_texelSize ) );
		[unroll] for( uint layer = 0; layer < maxLayers; ++layer )
			weights[layer] = lerp( weights[layer], fine[layer], detailShare );
		bakedWetness = fineExtra.x;
	}
	// Вода в точке — над точной землёй (детальная плитка или карта высот), как урез у воды (water.ps) и в плитках: вдали
	// рельеф рисуется грубее, а урез один. Где плитка с запечённой водой static — не нужна
	const bool liveWater = detailShare < 1.0f || g_wetnessBaked == 0 || g_showWater != 0;
	float waterDepth = -1e30f;
	float groundHeight = 0.0f;
	[branch] if( liveWater )
	{
		groundHeight = sampleFineHeight( position.xz );
		waterDepth = waterDepthAt( input.uv, groundHeight );
	}
	// Дно под водой (режим static: озёра) — галька по глубине в точке, урез внутри клетки (в splat-карте клеток озёр нет), у
	// нижних озёр глубже — наносы: дресва, затем ил (lakeBedShares); в детальном слое оно уже в весах. Вне детальных плиток
	// вода — озёра: у ручьёв плитки есть всегда
	[branch] if( g_waterBedLayer >= 0 && waterDepth > 0.03f )
	{
		const float bed = smoothstep( 0.03f, 0.15f, waterDepth ) * ( 1.0f - detailShare );
		const float2 sediment = lakeBedShares( waterDepth, waterDepth + groundHeight );
		const float pebbles = 1.0f - sediment.x - sediment.y;
		[unroll] for( uint layer = 0; layer < maxLayers; ++layer )
		{
			const int index = (int)layer;
			const float share = ( index == g_waterBedLayer ? pebbles : 0.0f ) + ( index == g_lakeGravelLayer ? sediment.x : 0.0f ) +
								( index == g_lakeSiltLayer ? sediment.y : 0.0f );
			weights[layer] = weights[layer] * ( 1.0f - bed ) + bed * share;
		}
	}
	// Под кронами — подстилка вместо трав (карта полога), как у тех, кто читает веса земли (terrainLayerWeightsAll)
	applyForestFloor( position.xz, weights );

	const TerrainLayerMix mixed = mixTerrainLayers( weights, farTextureShare( position ), 1.0f, position, positionDX, positionDY, projection );

	Surface surface;
	surface.transmission = 0.0f;
	surface.transmissionColor = 0.0f;
	surface.transmissionForward = 0.0f;
	surface.transmissionForwardRoughness = 1.0f;
	surface.position = input.worldPosition;
	surface.normal = normalize( normal + mixed.detail );
	surface.geometricNormal = normal;
	// Крупные пятна яркости — общие с травой на земле (terrain_layers.sh)
	surface.baseColor = mixed.albedo * terrainBrightness( position.xz );
	surface.metallic = 0.0f;
	surface.specular = 1.0f;
	surface.roughness = mixed.roughness;
	surface.occlusion = saturate( mixed.occlusion );
	surface.microShadows = terrainLayers().microShadows;
	surface.selfShadow = 1.0f;
	surface.screenOcclusion = screenAmbientOcclusion( input.position.xy, surface.position );
	surface.emissive = 0.0f;

	// Мокрая земля у воды и под ней: вода в порах — темнее и глаже (блик), как wet в материалах UE. В пикселе — по нарисованной
	// (смещённой дисплейсментом) земле против уровня воды у точки: под водой и полосой над урезом мокро, выше — сухо с резким
	// краем (bankWetness): мокрая линия идёт по камням, верх камня сухой, щель мокрая. Высота полосы у русел — из детального
	// слоя весов (G среза мокрости: у быстрой воды выше — брызги), вдали — «Wet bank height». Где вода недавно ушла
	// (simulated) — сохнет не сразу
	// Уровень воды у точки ищется только у воды: вне плиток он уже есть (waterDepth над точной землёй), в плитках — где у
	// текселя есть высота полосы (G > 0 — мокрый тексель в двух вокруг); иначе каждый пиксель рельефа у русел платил бы за поиск
	const float wetBand = lerp( terrainLayers().wetBankHeight, wetBandDecode( fineExtra.y ), detailShare );
	// Уровень — видимой воды: у камеры с поправкой окна мелкой воды (wetWaterDepth: плёс выше детальной воды, слив ниже)
	float wetDepth = -1e30f;
	[branch] if( liveWater )
		wetDepth = waterDepth > -1e29f ? waterDepth + groundHeight - input.worldPosition.y + nearWetLift( position.xz ) : -1e30f;
	else [branch] if( fineExtra.y > 0.0f )
		wetDepth = wetWaterDepth( position.xz, input.worldPosition.y );
	float liveWetness = wetDepth > -1e29f ? bankWetness( -wetDepth, wetBand ) : 0.0f;
	[branch] if( liveWater )
		liveWetness = max( liveWetness, smoothstep( 0.005f, 0.02f, recededWaterDepth( input.uv ) ) );
	// Мокрость кисти вдали — splat-карта (мазки в среднем по клетке), вблизи — в плитке
	const float baseWetness = g_splatMap.Sample( g_SamplerLinearClamp, float3( input.uv, splatSlices ) ).x;
	const float wet = max( liveWetness, lerp( baseWetness, bakedWetness, detailShare ) );
	surface.baseColor *= lerp( 1.0f, g_wetDarkening, wet );
	surface.roughness = lerp( surface.roughness, terrainLayers().wetRoughness, wet );

	// Отладка симуляции воды («Show water»): от 5 мм до 0,5 м глубины земля уходит в синий, быстрая вода — светлее
	[branch] if( g_showWater )
	{
		const WaterSample water = sampleWater( input.uv );
		const float cover = saturate( log10( max( waterDepth, 1e-6f ) / 0.005f ) * 0.5f );
		const float3 waterColor = lerp( float3( 0.01f, 0.04f, 0.25f ), float3( 0.5f, 0.75f, 1.0f ), saturate( length( water.velocity ) * 0.5f ) );
		surface.baseColor = lerp( surface.baseColor, waterColor, cover );
		surface.roughness = lerp( surface.roughness, 0.1f, cover );
		// Источники (по водосбору и помощники WaterSources) — оранжевым, от 0,01 до 1 мм/с притока
		const float source = saturate( log10( max( water.inflow, 1e-4f ) / 0.01f ) * 0.5f );
		surface.baseColor = lerp( surface.baseColor, float3( 1.0f, 0.35f, 0.02f ), source );
		surface.emissive = float3( 1.0f, 0.35f, 0.02f ) * source * 0.02f * ambientIrradiance( float3( 0.0f, 1.0f, 0.0f ) );
	}

	// Цель кисти (режим «Terrain paint», «Show target» подокна «Paint»): итог цели в точке — оранжевым поверх земли, сила —
	// значение (вес слоя среди слоёв пикселя, мокрость, маска), тёмные изолинии через 0,25 — читать «Value»; свечение — от
	// неба, как у «Show wind»: в тени видно так же. Та же подсветка маски — места звука («Sound sources», «Show area»),
	// бирюзовым: цвет — g_paintPreviewColor
	[branch] if( g_paintPreview >= 0 )
	{
		float value = 0.0f;
		if( g_paintPreview < (int)maxLayers )
		{
			float total = 0.0f;
			[unroll] for( uint i = 0; i < maxLayers; ++i )
				total += i < terrainLayers().layerCount ? weights[i] : 0.0f;
			value = weights[g_paintPreview] / max( total, 1e-5f );
		}
		else if( g_paintPreview == (int)maxLayers )
			value = wet;
		else
			value = g_paintMask.SampleLevel( g_SamplerLinearClamp, input.uv, 0.0f ).r;
		value = saturate( value );
		const float steps = value * 4.0f;
		const float slope = fwidth( steps );
		const float isoline = slope > 1e-4f ? 1.0f - saturate( abs( frac( steps + 0.5f ) - 0.5f ) / ( 1.5f * slope ) ) : 0.0f;
		const float3 highlight = g_paintPreviewColor;
		surface.baseColor = lerp( surface.baseColor, highlight * 0.6f, g_paintPreviewStrength * value ) * ( 1.0f - 0.7f * isoline );
		surface.emissive += highlight * value * ( 1.0f - isoline ) * 0.8f * g_paintPreviewStrength *
							dot( ambientIrradiance( float3( 0.0f, 1.0f, 0.0f ) ), float3( 0.2126f, 0.7152f, 0.0722f ) );
	}

	// Отладка поля ветра («Show wind»): стрелки — направление в центре клетки, цвет — множитель скорости против ветра уровня
	// (windSpeedColor: синий — штиль, зелёный — как ветер уровня, красный — вдвое быстрее), кайма — вертикаль (белая — вверх
	// по склону, чёрная — вниз); клетка — 8 м у камеры, вдали крупнее (по блокам 64 м, стрелки не режутся); земля — серая,
	// чуть тонированная тем же цветом, порывистость — тёмной штриховкой. Без освещения — свечением поверх земли
	[branch] if( g_showWind )
	{
		const float4 wind = windFieldSample( input.uv );
		const float hatch = frac( ( position.x + position.z ) * 0.5f ) < 0.5f ? 1.0f : 0.0f;
		float3 color = lerp( float3( 0.3f, 0.3f, 0.3f ), windSpeedColor( length( wind.xz ) ), 0.25f ) * ( 1.0f - 0.5f * hatch * saturate( wind.w ) );
		const float2 block = ( floor( position.xz / 64.0f ) + 0.5f ) * 64.0f;
		const float blockDistance = length( float3( block.x, position.y, block.y ) - cb_cameraPosition );
		const float arrowCell = clamp( exp2( floor( log2( max( blockDistance, 1.0f ) / 12.0f ) ) ), 8.0f, 64.0f );
		const float2 cellCenter = ( floor( position.xz / arrowCell ) + 0.5f ) * arrowCell;
		const float4 centerWind = windFieldSample( float2( cellCenter.x, g_worldSize - cellCenter.y ) / g_worldSize );
		const float centerSpeed = length( centerWind.xz );
		if( centerSpeed > 1e-3f )
		{
			const float2 along = centerWind.xz / centerSpeed;
			const float2 local = position.xz - cellCenter;
			const float a = dot( local, along ) / arrowCell;
			const float b = abs( dot( local, float2( -along.y, along.x ) ) ) / arrowCell;
			const float length01 = saturate( 0.25f + 0.2f * centerSpeed );
			const float headWidth = ( length01 + 0.06f - a ) * 0.8f;
			const bool shaft = a > -length01 && a < length01 - 0.12f && b < 0.04f;
			const bool head = a >= length01 - 0.12f && a < length01 + 0.06f && b < headWidth;
			if( shaft || head )
			{
				const bool inner = shaft ? b < 0.028f && a > -length01 + 0.015f : b < headWidth - 0.02f;
				const float lift = centerWind.y / centerSpeed;
				color = inner ? windSpeedColor( centerSpeed ) : lerp( float3( 0.0f, 0.0f, 0.0f ), float3( 1.0f, 1.0f, 1.0f ), saturate( 0.5f + lift * 2.0f ) );
			}
		}
		surface.baseColor = color * 0.6f;
		surface.roughness = 1.0f;
		// Яркость — от неба, цвет — свой: голубое небо иначе тонирует все стрелки в синий
		surface.emissive = color * 2.0f * dot( ambientIrradiance( float3( 0.0f, 1.0f, 0.0f ) ), float3( 0.2126f, 0.7152f, 0.0722f ) );
	}

	// Линейный HDR: экспозиция и тонмаппинг — в постобработке (Shaders/tonemap.ps)
	return float4( evaluateLighting( surface ), 1.0f );
}
