////////////////////////////////////////////////////////////////////////////////
// Материал террейна CDLOD (TerrainMaterial). Нормаль рельефа считается по карте высот, веса до восьми слоёв
// берутся из каналов splat-карты — массива из двух RGBA, как weightmap в UE Landscape. Текстуры читаются только у
// четырёх самых весомых слоёв пикселя. Слой — пара текстур из массивов: альбедо + высота и нормаль + шероховатость.
// Текстура слоя проецируется сверху, а на крутых склонах ещё и вдоль осей X и Z (triplanar), поэтому на скалах
// не растягивается. Слои смешиваются по высоте: где веса близки, видна более высокая текстура (камни из травы).
// Вдали повтор текстуры крупнее (distance resampling, как в материалах UE Landscape): мелкий повтор (скала, снег)
// издалека складывается в сетку
////////////////////////////////////////////////////////////////////////////////

#include "lighting.sh"
#include "cdlod.sh"

Texture2DArray g_splatMap : register( t1 );		// срез 0 — веса слоёв 0…3, срез 1 — 4…7
Texture2DArray g_albedoHeight : register( t2 );
Texture2DArray g_normalRoughness : register( t3 );
Texture2D g_noise : register( t4 );		// белый шум 256×256, R8_SNORM

static const uint maxLayers = 8;
// Слоёв с выборкой текстур в пикселе: больше трёх-четырёх в одной точке не бывает, а массив из восьми LayerSample
// занял бы регистры и снизил занятость GPU
static const uint activeLayers = 4;
static const float minWeight = 0.01f;	// слой или проекцию с меньшим вкладом не читаем

struct LayerSample
{
	float3 albedo;
	float  height;
	float3 detail;		// отклонение нормали по карте нормалей, в мировых координатах
	float  roughness;
};

// Нормаль рельефа: центральные разности в мипе карты высот, тексель которого примерно равен пикселю экрана.
// Геометрия вдали грубее карты высот, но освещение по такой нормали остаётся детальным
float3 terrainNormal( float2 worldXZ, float mip )
{
	float offset = g_texelSize * exp2( mip );
	float left  = sampleHeight( worldXZ - float2( offset, 0.0f ), mip );
	float right = sampleHeight( worldXZ + float2( offset, 0.0f ), mip );
	float back  = sampleHeight( worldXZ - float2( 0.0f, offset ), mip );
	float front = sampleHeight( worldXZ + float2( 0.0f, offset ), mip );
	return normalize( float3( left - right, 2.0f * offset, back - front ) );
}

// Веса проекций triplanar по нормали рельефа; малые отбрасываются
float3 projectionWeights( float3 normal )
{
	float3 weights = pow( abs( normal ), g_triplanarSharpness );
	weights /= dot( weights, 1.0f );
	weights *= step( minWeight, weights );
	return weights / dot( weights, 1.0f );
}

// tangent и bitangent — направления роста u и v проекции в мире. Отклонение нормали добавляется к нормали рельефа
// в плоскости проекции (UDN): для плоского участка это обычный normal mapping
void addProjection( inout LayerSample result, float weight, float layer, float2 uv, float2 uvDX, float2 uvDY,
					float3 tangent, float3 bitangent )
{
	float4 albedoHeight = g_albedoHeight.SampleGrad( g_SamplerAnisotropicWrap, float3( uv, layer ), uvDX, uvDY );
	float4 normalRoughness = g_normalRoughness.SampleGrad( g_SamplerAnisotropicWrap, float3( uv, layer ), uvDX, uvDY );
	float2 slope = normalRoughness.xy * 2.0f - 1.0f;

	result.albedo += albedoHeight.rgb * weight;
	result.height += albedoHeight.a * weight;
	result.detail += ( tangent * slope.x + bitangent * slope.y ) * weight;
	result.roughness += normalRoughness.a * weight;
}

// Проекции слоя с повтором scale (повторов на метр), вклад — с весом weight.
// Производные позиции считаются до ветвлений: внутри них неявные производные не определены, поэтому SampleGrad
void addProjections( inout LayerSample result, float weight, uint layer, float scale, float3 position, float3 positionDX,
					 float3 positionDY, float3 projection )
{
	// Сверху: u вдоль X, v вдоль Z
	[branch] if( projection.y > 0.0f )
	{
		addProjection( result, projection.y * weight, layer, position.xz * scale, positionDX.xz * scale, positionDY.xz * scale,
					   float3( 1.0f, 0.0f, 0.0f ), float3( 0.0f, 0.0f, 1.0f ) );
	}
	// Вдоль X: u вдоль Z, v вниз по Y, чтобы верх текстуры смотрел вверх
	[branch] if( projection.x > 0.0f )
	{
		addProjection( result, projection.x * weight, layer, float2( position.z, -position.y ) * scale,
					   float2( positionDX.z, -positionDX.y ) * scale, float2( positionDY.z, -positionDY.y ) * scale,
					   float3( 0.0f, 0.0f, 1.0f ), float3( 0.0f, -1.0f, 0.0f ) );
	}
	// Вдоль Z: u вдоль X, v вниз по Y
	[branch] if( projection.z > 0.0f )
	{
		addProjection( result, projection.z * weight, layer, float2( position.x, -position.y ) * scale,
					   float2( positionDX.x, -positionDX.y ) * scale, float2( positionDY.x, -positionDY.y ) * scale,
					   float3( 1.0f, 0.0f, 0.0f ), float3( 0.0f, -1.0f, 0.0f ) );
	}
}

// far — доля крупного масштаба (0 — вблизи, 1 — вдали): обе выборки только в полосе перехода
LayerSample sampleLayer( uint layer, float far, float3 position, float3 positionDX, float3 positionDY, float3 projection )
{
	LayerSample result = (LayerSample)0;
	const float scale = g_layerScale[layer / 4][layer % 4];
	[branch] if( far < 1.0f )
		addProjections( result, 1.0f - far, layer, scale, position, positionDX, positionDY, projection );
	[branch] if( far > 0.0f )
		addProjections( result, far, layer, scale / g_farTextureScale, position, positionDX, positionDY, projection );
	return result;
}

// Смешивание по высоте (A. Mishkinis, «Advanced Terrain Texture Splatting»): к весу слоя из splat-карты
// прибавляется высота его текстуры, и виден только тот слой, чья сумма не ниже максимума больше чем на g_heightBlendDepth
float4 heightBlend( float4 splat, float4 heights )
{
	float4 level = splat + heights;
	float threshold = max( max( level.x, level.y ), max( level.z, level.w ) ) - g_heightBlendDepth;
	float4 blend = max( level - threshold, 0.0f ) * step( minWeight, splat );
	return blend / max( dot( blend, 1.0f ), 1e-5f );
}

float4 main( PixelInputType input ) : SV_TARGET
{
	float3 position = input.worldPosition;
	float3 positionDX = ddx( position );
	float3 positionDY = ddy( position );

	float footprint = max( length( positionDX.xz ), length( positionDY.xz ) );
	float3 normal = terrainNormal( position.xz, max( log2( footprint / g_texelSize ), 0.0f ) );
	float3 projection = projectionWeights( normal );

	const float4 splat0 = g_splatMap.Sample( g_SamplerLinearClamp, float3( input.uv, 0.0f ) );
	const float4 splat1 = g_splatMap.Sample( g_SamplerLinearClamp, float3( input.uv, 1.0f ) );
	const float weights[maxLayers] = { splat0.x, splat0.y, splat0.z, splat0.w, splat1.x, splat1.y, splat1.z, splat1.w };

	// Четыре самых весомых слоя по убыванию веса; слои, которых нет в TerrainLayers, веса не получают
	float4 splat = 0.0f;
	uint4 layerIndex = 0;
	[unroll] for( uint i = 0; i < maxLayers; ++i )
	{
		float weight = i < g_layerCount ? weights[i] : 0.0f;
		uint layer = i;
		[unroll] for( uint k = 0; k < activeLayers; ++k )
		{
			if( weight > splat[k] )
			{
				const float lighter = splat[k];
				const uint lighterLayer = layerIndex[k];
				splat[k] = weight;
				layerIndex[k] = layer;
				weight = lighter;
				layer = lighterLayer;
			}
		}
	}
	splat /= max( dot( splat, 1.0f ), 1e-5f );
	const float far = saturate( ( length( position - cb_cameraPosition ) - g_farBlendStart ) / ( g_farBlendEnd - g_farBlendStart ) );

	LayerSample layers[activeLayers];
	float4 heights = 0.0f;
	[unroll] for( uint j = 0; j < activeLayers; ++j )
	{
		layers[j] = (LayerSample)0;
		[branch] if( splat[j] > minWeight )
		{
			layers[j] = sampleLayer( layerIndex[j], far, position, positionDX, positionDY, projection );
		}
		heights[j] = layers[j].height;
	}

	float4 blend = heightBlend( splat, heights );
	LayerSample mixed = (LayerSample)0;
	[unroll] for( uint n = 0; n < activeLayers; ++n )
	{
		mixed.albedo += layers[n].albedo * blend[n];
		mixed.detail += layers[n].detail * blend[n];
		mixed.roughness += layers[n].roughness * blend[n];
	}

	// Крупные пятна яркости (тексели шума по 40 и 13 м), чтобы вдали не было заметно повторение текстур
	float variation = g_noise.Sample( g_SamplerLinearWrap, position.xz / 10240.0f ).r * 0.6f +
					  g_noise.Sample( g_SamplerLinearWrap, position.xz / 3328.0f ).r * 0.4f;

	Surface surface;
	surface.transmission = 0.0f;
	surface.transmissionColor = 0.0f;
	surface.position = position;
	surface.normal = normalize( normal + mixed.detail );
	surface.geometricNormal = normal;
	surface.baseColor = mixed.albedo * ( 1.0f + 0.15f * variation );
	surface.metallic = 0.0f;
	surface.roughness = mixed.roughness;
	surface.occlusion = 1.0f;
	surface.emissive = 0.0f;

	// Линейный HDR: экспозиция и тонмаппинг — в постобработке (Shaders/tonemap.ps)
	return float4( evaluateLighting( surface ), 1.0f );
}
