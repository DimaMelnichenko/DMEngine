////////////////////////////////////////////////////////////////////////////////
// Фон кадра — небо: таблицы Sky-View по направлению взгляда со свечением ночного неба и землёй под горизонтом
// (skyLuminance, Shaders/sky_view.sh), диски солнца и луны. Рисуется после непрозрачных на дальней плоскости — только
// там, где сцена ничего не нарисовала; звёзды — поверх него своим вызовом (Shaders/sky_stars.vs)
////////////////////////////////////////////////////////////////////////////////

#include "common.vs"
#include "samplers.sh"
#define ATMOSPHERE_NO_SKY
#include "sky_view.sh"
#include "exposure.sh"
#include "height_fog.sh"
#include "night_sky.sh"
#include "bindless.sh"

DM_SRV( Texture2D, g_moonAlbedo, 5 );	// карта луны: равнопромежуточная, долгота 0 — в центре (видимая сторона)

struct PixelInputType
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
};

// Угловой радиус солнца — вдвое больше настоящего (0,27°), чтобы диск был заметен на экране
static const float sunAngularRadius = 0.0093f;

// Диск луны: шар, освещённый солнцем (фаза и терминатор — сами), альбедо — карта NASA по селенографическим координатам;
// север луны — к северному полюсу мира на небе. Ломмель — Зелигер (μ₀ / (μ₀ + μ)): полная луна — ровный диск без
// потемнения к краю, как настоящая
float3 moonLight( float3 direction )
{
	const float3 toMoon = g_moonDirection;
	const float cosAngle = dot( direction, toMoon );
	const float sinRadius = sin( g_moonAngularRadius );
	if( cosAngle < cos( g_moonAngularRadius * 1.05f ) )
		return 0.0f;

	float3 north = g_equatorialZ - toMoon * dot( g_equatorialZ, toMoon );
	north = dot( north, north ) > 1e-8f ? normalize( north ) : float3( 0.0f, 1.0f, 0.0f );
	const float3 west = cross( north, toMoon );
	const float3 offset = direction - toMoon * cosAngle;
	const float2 disk = float2( dot( offset, west ), dot( offset, north ) ) / sinRadius;
	const float r2 = dot( disk, disk );
	const float coverage = 1.0f - smoothstep( 0.97f, 1.0f, sqrt( r2 ) );
	if( coverage <= 0.0f )
		return 0.0f;

	// Нормаль поверхности луны к наблюдателю; селенографическая долгота растёт к западу неба (море Кризисов — справа)
	const float3 normal = disk.x * west + disk.y * north - sqrt( saturate( 1.0f - r2 ) ) * toMoon;
	const float latitude = asin( clamp( dot( normal, north ), -1.0f, 1.0f ) );
	const float longitude = atan2( dot( normal, west ), dot( normal, -toMoon ) );
	const float2 uv = float2( 0.5f + longitude / ( 2.0f * atmospherePi ), 0.5f - latitude / atmospherePi );
	uint width, height, mips;
	g_moonAlbedo.GetDimensions( 0, width, height, mips );
	// Альбедо относительно среднего по карте (последний мип): яркость задаёт освещённость, карта — только узор
	const float3 albedo = g_moonAlbedo.SampleLevel( g_SamplerLinearWrap, uv, 0.0f ).rgb /
						  max( g_moonAlbedo.SampleLevel( g_SamplerLinearWrap, float2( 0.5f, 0.5f ), mips - 1 ).rgb, 1e-3f );

	const float incidence = saturate( dot( normal, g_sunDirection ) );
	const float emission = saturate( -dot( normal, toMoon ) );
	const float lommelSeeliger = incidence / max( incidence + emission, 1e-4f );
	// Полная луна: μ₀ = μ, ровно 1/2 по диску — отсюда множитель 2 к яркости полного диска
	return g_moonDiskLuminance * albedo * ( 2.0f * lommelSeeliger ) * coverage;
}

float4 main( PixelInputType input ) : SV_TARGET
{
	// Луч взгляда: из экранных координат в пространство камеры (левое, взгляд по +Z), затем в мир
	float2 ndc = float2( input.uv.x * 2.0f - 1.0f, 1.0f - input.uv.y * 2.0f );
	float3 viewDirection = float3( ndc.x / cb_projectionMatrix[0][0], ndc.y / cb_projectionMatrix[1][1], 1.0f );
	float3 direction = normalize( mul( viewDirection, (float3x3)cb_viewInverseMatrix ) );

	// Небо запечено для солнца 1 лк над атмосферой: яркость, кд/м², — умножением на освещённость от солнца
	float3 color = skyLuminance( direction );

	// Солнце и луна — над атмосферой, у наблюдателя — с пропусканием по лучу взгляда (на закате диск
	// красный, под горизонтом его закрывает земля — пропускание 0)
	const float3 transmittance = transmittanceToTop( observerAltitude, direction.y );
	float3 lights = 0.0f;

	// Диск солнца: яркость над атмосферой = освещённость / телесный угол, с мягким краем. Только для пикселей диска
	float angle = acos( saturate( dot( direction, g_sunDirection ) ) );
	float disk = 1.0f - smoothstep( sunAngularRadius * 0.8f, sunAngularRadius, angle );
	[branch] if( disk > 0.0f )
	{
		float solidAngle = atmospherePi * sunAngularRadius * sunAngularRadius;
		lights += g_sunColor / solidAngle * disk;
	}

	[branch] if( any( g_moonDiskLuminance > 0.0f ) )
	{
		// Ночью экспозиция — для пейзажа, диск в ~10⁵ раз ярче и у камеры ушёл бы в засветку и bloom, как солнце;
		// глаз видит белый диск с морями. Диск приглушается целиком (узор морей сохраняется), чтобы полный диск после
		// экспозиции был не ярче предела. Днём луна тусклее неба — множитель 1
		float moonScale = 1.0f;
		[branch] if( g_moonDiskBrightnessLimit > 0.0f )
		{
			const float fullDisk = dot( g_moonDiskLuminance, float3( 0.2126f, 0.7152f, 0.0722f ) ) * cb_skyScale * preExposure();
			moonScale = min( 1.0f, g_moonDiskBrightnessLimit / max( fullDisk, 1e-20f ) );
		}
		lights += moonLight( direction ) * moonScale;
	}

	color += lights * transmittance;
	// Туман уровня — между камерой и небом (Shaders/height_fog.sh)
	return float4( applyHeightFogToSky( color * cb_skyScale, direction ) * preExposure(), 1.0f );
}
