////////////////////////////////////////////////////////////////////////////////
// Фон кадра — небо: таблицы Sky-View по направлению взгляда со свечением ночного неба и землёй под горизонтом
// (skyLuminance, Shaders/sky_view.sh), диски солнца и луны, ночью — Млечный Путь. Рисуется после непрозрачных на дальней
// плоскости — только там, где сцена ничего не нарисовала; звёзды — поверх него своим вызовом (Shaders/sky_stars.vs)
////////////////////////////////////////////////////////////////////////////////

#include "common.vs"
#include "samplers.sh"
#define ATMOSPHERE_NO_SKY
#include "sky_view.sh"
#include "exposure.sh"
#include "height_fog.sh"
#include "night_sky.sh"
#include "bindless.sh"

DM_SRV( Texture2D, g_moonAlbedo, 5 );	// карта луны: равнопромежуточная, долгота 0 — в центре (видимая сторона)
// Млечный Путь: равнопромежуточная по RA/Dec J2000, RA 0 — в центре и растёт влево, как на картах неба; среднее по сфере — 1
DM_SRV( Texture2D, g_milkyWay, 7 );

struct PixelInputType
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
};

// Угловой радиус солнца — вдвое больше настоящего (0,27°), чтобы диск был заметен на экране
static const float sunAngularRadius = 0.0093f;

// Диск луны: шар, освещённый солнцем (фаза и терминатор — сами), альбедо — карта NASA по селенографическим координатам в
// базисе тела луны (либрация и позиционный угол оси). Ломмель — Зелигер (μ₀ / (μ₀ + μ)): полная луна — ровный диск без
// потемнения к краю, как настоящая. Пепельный свет — тёмная часть, освещённая Землёй: Земля почти там же, где
// наблюдатель, поэтому по Ломмелю — Зелигеру он ровный по всему диску, с морями. sunScale и earthScale — приглушение
// освещённой солнцем части и пепельного света после экспозиции; pixelAngle — размер пикселя, рад (мип карты)
float3 moonLight( float3 direction, float pixelAngle, float sunScale, float earthScale )
{
	const float3 toMoon = g_moonDirection;
	const float cosAngle = dot( direction, toMoon );
	const float sinRadius = sin( g_moonAngularRadius );
	if( cosAngle < cos( g_moonAngularRadius * 1.05f ) )
		return 0.0f;

	// Координаты на диске — в любом базисе плоскости неба: север неба и запад
	float3 north = g_equatorialZ - toMoon * dot( g_equatorialZ, toMoon );
	north = dot( north, north ) > 1e-8f ? normalize( north ) : float3( 0.0f, 1.0f, 0.0f );
	const float3 west = cross( north, toMoon );
	const float3 offset = direction - toMoon * cosAngle;
	const float2 disk = float2( dot( offset, west ), dot( offset, north ) ) / sinRadius;
	const float r2 = dot( disk, disk );
	const float coverage = 1.0f - smoothstep( 0.97f, 1.0f, sqrt( r2 ) );
	if( coverage <= 0.0f )
		return 0.0f;

	// Нормаль поверхности луны к наблюдателю; селенографические координаты — по базису тела (долгота растёт к Морю Кризисов)
	const float3 normal = disk.x * west + disk.y * north - sqrt( saturate( 1.0f - r2 ) ) * toMoon;
	const float latitude = asin( clamp( dot( normal, g_moonNorth ), -1.0f, 1.0f ) );
	const float longitude = atan2( dot( normal, g_moonEast ), dot( normal, g_moonPrime ) );
	const float2 uv = float2( 0.5f + longitude / ( 2.0f * atmospherePi ), 0.5f - latitude / atmospherePi );
	uint width, height, mips;
	g_moonAlbedo.GetDimensions( 0, width, height, mips );
	// Мип — под размер диска на экране: в центре диска тексель карты (2π / width рад) — это радиус диска в пикселях × 2π / width
	const float diskRadiusPixels = g_moonAngularRadius / pixelAngle;
	const float mip = log2( max( width / ( 2.0f * atmospherePi * diskRadiusPixels ), 1.0f ) );
	// Альбедо относительно среднего по карте (последний мип): яркость задаёт освещённость, карта — только узор
	const float3 albedo = g_moonAlbedo.SampleLevel( g_SamplerLinearWrap, uv, mip ).rgb /
						  max( g_moonAlbedo.SampleLevel( g_SamplerLinearWrap, float2( 0.5f, 0.5f ), mips - 1 ).rgb, 1e-3f );

	const float incidence = saturate( dot( normal, g_sunDirection ) );
	const float emission = saturate( -dot( normal, toMoon ) );
	const float lommelSeeliger = incidence / max( incidence + emission, 1e-4f );
	// Полная луна: μ₀ = μ, ровно 1/2 по диску — отсюда множитель 2 к яркости полного диска; у пепельного света μ₀ ≈ μ
	return g_moonDiskLuminance * albedo * ( 2.0f * lommelSeeliger * sunScale + g_earthshine * earthScale ) * coverage;
}

// Свет звёзд слабее каталога (Shaders/sky_stars.vs) — карта яркости в экваториальных координатах; мип — под размер
// пикселя pixelAngle (радианы): явно, иначе на стыке RA 0/360° производные u скачут и выборка уходит в последний мип
float3 milkyWayLight( float3 direction, float pixelAngle )
{
	const float3 d = float3( dot( direction, g_equatorialX ), dot( direction, g_equatorialY ), dot( direction, g_equatorialZ ) );
	const float2 uv = float2( 0.5f - atan2( d.y, d.x ) / ( 2.0f * atmospherePi ), 0.5f - asin( clamp( d.z, -1.0f, 1.0f ) ) / atmospherePi );
	uint width, height, mips;
	g_milkyWay.GetDimensions( 0, width, height, mips );
	const float mip = log2( max( pixelAngle * width / ( 2.0f * atmospherePi ), 1.0f ) );
	return g_milkyWay.SampleLevel( g_SamplerLinearWrap, uv, mip ).rgb * g_milkyWayLuminance;
}

float4 main( PixelInputType input ) : SV_TARGET
{
	// Луч взгляда: из экранных координат в пространство камеры (левое, взгляд по +Z), затем в мир
	float2 ndc = float2( input.uv.x * 2.0f - 1.0f, 1.0f - input.uv.y * 2.0f );
	float3 viewDirection = float3( ndc.x / cb_projectionMatrix[0][0], ndc.y / cb_projectionMatrix[1][1], 1.0f );
	float3 direction = normalize( mul( viewDirection, (float3x3)cb_viewInverseMatrix ) );

	// Небо запечено для солнца 1 лк над атмосферой: яркость, кд/м², — умножением на освещённость от солнца
	float3 color = skyLuminance( direction );

	// Солнце и луна — над атмосферой, у наблюдателя — с пропусканием по лучу взгляда (на закате диск
	// красный, под горизонтом его закрывает земля — пропускание 0)
	const float3 transmittance = transmittanceToTop( observerAltitude, direction.y );
	float3 lights = 0.0f;

	// Диск солнца: яркость над атмосферой = освещённость / телесный угол, с мягким краем. Только для пикселей диска
	float angle = acos( saturate( dot( direction, g_sunDirection ) ) );
	float disk = 1.0f - smoothstep( sunAngularRadius * 0.8f, sunAngularRadius, angle );
	[branch] if( disk > 0.0f )
	{
		float solidAngle = atmospherePi * sunAngularRadius * sunAngularRadius;
		lights += g_sunColor / solidAngle * disk;
	}

	// Размер пикселя в радианах — до ветвлений: производные внутри них не определены
	const float pixelAngle = max( max( length( ddx( direction ) ), length( ddy( direction ) ) ), 1e-6f );

	[branch] if( any( g_moonDiskLuminance > 0.0f ) )
	{
		// Ночью экспозиция — для пейзажа, диск в ~10⁵ раз ярче и у камеры ушёл бы в засветку и bloom, как солнце;
		// глаз видит белый диск с морями. Диск приглушается целиком (узор морей сохраняется), чтобы полный диск после
		// экспозиции был не ярче предела. Днём луна тусклее неба — множитель 1. Пепельный свет — так же, своим пределом:
		// глаз видит его тусклым серым диском рядом с белым серпом, хотя он в ~10⁴ раз темнее серпа
		const float fullDisk = dot( g_moonDiskLuminance, float3( 0.2126f, 0.7152f, 0.0722f ) ) * cb_skyScale * preExposure();
		const float sunScale = g_moonDiskBrightnessLimit > 0.0f ? min( 1.0f, g_moonDiskBrightnessLimit / max( fullDisk, 1e-20f ) ) : 1.0f;
		const float earthScale = g_earthshineBrightnessLimit > 0.0f ?
			min( 1.0f, g_earthshineBrightnessLimit / max( fullDisk * g_earthshine, 1e-20f ) ) : 1.0f;
		lights += moonLight( direction, pixelAngle, sunScale, earthScale );
	}

	[branch] if( g_milkyWayLuminance > 0.0f && direction.y > -0.05f )
		lights += milkyWayLight( direction, pixelAngle );

	color += lights * transmittance;
	// Туман уровня — между камерой и небом (Shaders/height_fog.sh)
	return float4( applyHeightFogToSky( color * cb_skyScale, direction ) * preExposure(), 1.0f );
}
