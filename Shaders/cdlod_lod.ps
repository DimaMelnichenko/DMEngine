////////////////////////////////////////////////////////////////////////////////
// Отладочный вид террейна CDLOD: цвет уровня LOD, перетекающий в цвет следующего уровня
// по мере морфинга, и простое освещение по нормали из производных позиции
////////////////////////////////////////////////////////////////////////////////

#include "cdlod.sh"

static const float3 g_levelColors[8] =
{
	float3( 1.0f, 0.2f, 0.2f ),
	float3( 1.0f, 0.6f, 0.1f ),
	float3( 1.0f, 1.0f, 0.2f ),
	float3( 0.3f, 1.0f, 0.3f ),
	float3( 0.2f, 0.9f, 1.0f ),
	float3( 0.3f, 0.4f, 1.0f ),
	float3( 0.8f, 0.3f, 1.0f ),
	float3( 1.0f, 1.0f, 1.0f )
};

float4 main( PixelInputType input ) : SV_TARGET
{
	uint level = (uint)input.lodDebug.x;
	float3 color = lerp( g_levelColors[level % 8], g_levelColors[( level + 1 ) % 8], input.lodDebug.y );

	float3 normal = normalize( cross( ddy( input.worldPosition ), ddx( input.worldPosition ) ) );
	normal *= normal.y < 0.0f ? -1.0f : 1.0f;	// у террейна нормаль всегда смотрит вверх
	float light = 0.3f + 0.7f * saturate( dot( normal, normalize( float3( 0.4f, 1.0f, 0.3f ) ) ) );

	return float4( color * light, 1.0f );
}
