////////////////////////////////////////////////////////////////////////////////
// Частица (ParticleSystem): форма — мягкое пятно, узкая полоса хвоинки или клочок взбитой воды (пятно с рваным краем
// и пузырями внутри); мягкий край по глубине сцены (soft particles: у земли и травы частица гаснет, а не обрезается
// линией)
////////////////////////////////////////////////////////////////////////////////

#include "common.vs"
#include "samplers.sh"
#include "particles.sh"
#include "bindless.sh"

DM_SRV( Texture2D<float>, g_sceneDepth, SLOT_SCENE_DEPTH );

struct ParticlePixelInput
{
	float4 position : SV_POSITION;
	float3 color : COLOR0;
	float  alpha : COLOR1;
	float2 corner : TEXCOORD0;
	float  viewDepth : TEXCOORD1;
	nointerpolation float3 random : TEXCOORD2;
	float3 shade : COLOR2;
	nointerpolation float3 glint : COLOR3;
	nointerpolation float3 toSun : TEXCOORD3;
};

static const float softDistance = 0.3f;		// м: на этой толщине до сцены частица гаснет
// У клочков взбитой воды — тоньше: они у самой воды, а дно мелкого ручья в 5–15 см под ней (с 0,3 м клочки там были почти
// прозрачны)
static const float frothSoftDistance = 0.05f;
// Узор пены воды (WaterFoamLace): срез 1 — густая пена, маска 0,35…1, нормаль по ней — у клочков взбитой воды
DM_SRV( Texture2DArray<float4>, g_foamPattern, SLOT_WATER_FOAM_PATTERN );
// Спрайт клочка (колонка sprite эмиттера, Tools/pack_particle_sprite.py): R — покрытие, G, B — нормаль, A — плотность;
// несколько фото — кадры в ряд (ширина — кадров × высота), кадр — по зерну частицы
DM_SRV( Texture2D<float4>, g_sprite, 1 );
// Клочок взбитой воды: доля узора на поперечник пятна (узор пены у воды — 0,5 м на повтор, клочок — 6–16 см); у частицы —
// × 0,6…1,6: пузыри разного размера
static const float frothPattern = 0.6f;
static const float frothLumps = 0.15f;	// крупные пятна края — доля узора кружева на поперечник клочка
// Тонкая взбитая вода — серо-голубая (тёмная вода сквозь неё), плотная — белая
static const float3 frothThin = float3( 0.55f, 0.66f, 0.72f );
// Искры — блики солнца на пузырях: ячеек сетки на поперечник клочка, доля ячеек с пузырём-бликом, острота блика и яркость
static const float glintCells = 22.0f;
static const float glintShare = 0.5f;
static const float glintPower = 60.0f;
static const float glintStrength = 8.0f;

// Клочок взбитой воды (бурление у падений, Dimok, 2026-10-22: «бурлящая вода в месте падения», референс — фото белой
// воды вблизи): бугристое пятно с рваным краем, внутри — пузыри густой пены (узор тот же, что у пены на воде; поворот,
// сдвиг и масштаб — свои у частицы). Освещён в пикселе: нормаль — бугристый шар и рельеф пузырей узора, светлые верха к
// солнцу и серые впадины; где узор реже — край прозрачнее и вода сквозь него серо-голубая; на пузырях — искры солнца
float4 frothColor( ParticlePixelInput input )
{
	const float3 random = input.random;
	const float angle = random.x * 6.2831853f;
	const float c = cos( angle );
	const float s = sin( angle );
	const float2 corner = input.corner;
	const float2 p = float2( c * corner.x - s * corner.y, s * corner.x + c * corner.y );
	float body = saturate( 1.0f - dot( p, p ) );
	body *= body;
	float density;
	float alpha;
	float4 foam;
	[branch] if( g_hasSprite != 0 )
	{
		// Спрайт всплеска (фото, Dimok): покрытие, рельеф и плотность — из него; повёрнут и отражён по-своему у частицы.
		// Прозрачное (у всплеска — почти девять десятых квада) — сразу мимо: без света, искр и глубины сцены
		uint width, height;
		g_sprite.GetDimensions( width, height );
		const float frames = max( floor( (float)width / max( (float)height, 1.0f ) ), 1.0f );
		const float frame = min( floor( frac( random.y * 13.7f ) * frames ), frames - 1.0f );
		const float mirror = random.z < 0.5f ? 1.0f : -1.0f;
		float2 uv = saturate( float2( mirror * p.x, p.y ) * 0.5f + 0.5f );
		uv.x = ( frame + uv.x ) / frames;
		const float4 sprite = g_sprite.Sample( g_SamplerLinearClamp, uv );
		clip( sprite.r * input.alpha - 1.0f / 255.0f );
		// Нормаль спрайта — в осях картинки (v вниз): в оси клочка (y вверх), с его отражением
		const float2 bump = ( sprite.gb * 2.0f - 1.0f ) * float2( mirror, -1.0f );
		foam = float4( sprite.a, 0.5f + 0.5f * bump, 0.0f );
		density = sprite.a;
		alpha = sprite.r;
	}
	else
	{
		// Рваный край и провалы — крупные пятна кружева (срез 0): масса клочка не круг
		const float lumps = g_foamPattern.Sample( g_SamplerLinearWrap, float3( p * frothLumps + random.zy, 0.0f ) ).r;
		const float scale = frothPattern * lerp( 0.6f, 1.6f, frac( random.y * 7.31f ) );
		foam = g_foamPattern.Sample( g_SamplerLinearWrap, float3( p * scale + random.yz, 1.0f ) );
		density = foam.r;
		// Край — мягко по форме клочка (Dimok: «края у этих клочков довольно резкие»), пузыри — плотность внутри, а не вырезы
		float coverage = saturate( 1.8f * body * lerp( 0.5f, 1.5f, lumps ) );
		coverage = coverage * coverage * ( 3.0f - 2.0f * coverage );
		alpha = coverage * lerp( 0.3f, 1.0f, density );
	}

	// Нормаль: бугристый шар (к камере в середине) и рельеф пузырей узора (повёрнут обратно в оси квада)
	const float2 bump = foam.gb * 2.0f - 1.0f;
	const float2 bumpCorner = float2( c * bump.x + s * bump.y, -s * bump.x + c * bump.y );
	const float3 local = normalize( float3( corner * 0.9f + bumpCorner * 0.7f, sqrt( saturate( 1.0f - dot( corner, corner ) ) ) + 0.2f ) );
	const float3 right = cb_viewInverseMatrix[0].xyz;
	const float3 up = cb_viewInverseMatrix[1].xyz;
	const float3 toCamera = -cb_viewInverseMatrix[2].xyz;
	const float3 normal = normalize( right * local.x + up * local.y + toCamera * local.z );

	// Свет: от тени (небо) к стороне, обращённой к солнцу (мягко — свет рассеивается в пене); тонкая — серо-голубая
	const bool sun = dot( input.toSun, input.toSun ) > 0.5f;
	const float lit = sun ? saturate( dot( normal, input.toSun ) * 0.8f + 0.2f ) : 0.0f;
	float3 color = lerp( input.shade, input.color, lit ) * lerp( frothThin, 1.0f, saturate( density * body * 1.6f ) );

	// Искры: ячейка мелкой сетки — пузырь с бликом (случайная грань), блестит, если грань смотрит между солнцем и камерой
	float spark = 0.0f;
	[branch] if( sun )
	{
		const float2 g = p * glintCells + random.zx * 57.0f;
		const int2 cell = int2( floor( g ) );
		uint state = (uint)( cell.x * 73856093 ) ^ (uint)( cell.y * 19349663 ) ^ (uint)( random.x * 16777216.0f );
		const float chosen = particleRandom( state );
		const float2 center = float2( particleRandom( state ), particleRandom( state ) ) * 0.6f + 0.2f;
		const float3 facet = normalize( normal + ( float3( particleRandom( state ), particleRandom( state ), particleRandom( state ) ) - 0.5f ) * 1.6f );
		const float bubble = 1.0f - smoothstep( 0.04f, 0.12f, length( frac( g ) - center ) );
		const float3 halfway = normalize( input.toSun + toCamera );
		spark = chosen < glintShare ? bubble * pow( saturate( dot( facet, halfway ) ), glintPower ) * density * body : 0.0f;
	}
	color += input.glint * spark * glintStrength;
	return float4( color, saturate( alpha + spark ) );
}

float4 main( ParticlePixelInput input ) : SV_TARGET
{
	float shape;
	float3 color = input.color;
	if( g_shape == particleShapeNeedle )
		shape = ( 1.0f - smoothstep( 0.3f, 1.0f, abs( input.corner.x ) ) ) * ( 1.0f - smoothstep( 0.8f, 1.0f, abs( input.corner.y ) ) );
	else if( g_shape == particleShapeFroth )
	{
		const float4 froth = frothColor( input );
		color = froth.rgb;
		shape = froth.a;
	}
	else
	{
		const float r = length( input.corner );
		shape = saturate( 1.0f - r * r );
		shape *= shape;
	}

	// Глубина сцены обратная: z вида = P₃₂ / (глубина − P₂₂); над небом (0) — далеко
	const float sceneDepth = g_sceneDepth[uint2( input.position.xy )];
	const float sceneViewZ = sceneDepth > 0.0f ? cb_projectionMatrix[3][2] / ( sceneDepth - cb_projectionMatrix[2][2] ) : 1e9f;
	const float soft = saturate( ( sceneViewZ - input.viewDepth ) / ( g_shape == particleShapeFroth ? frothSoftDistance : softDistance ) );

	const float alpha = saturate( input.alpha * shape * soft );
	clip( alpha - 1.0f / 255.0f );
	return float4( color, alpha );
}
