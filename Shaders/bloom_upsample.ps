////////////////////////////////////////////////////////////////////////////////
// Bloom: увеличение уровня вдвое тентом 3 × 3 (J. Jimenez, SIGGRAPH 2014) с добавлением в уровень крупнее —
// PostProcess рисует его с BlendState::additive, от самого маленького уровня к самому большому. Добавляемый уровень
// ослабляется весом g_weight: чем шире уровень, тем меньше его вклад, как у весов уровней bloom в UE и у рассеяния
// в объективе — вокруг яркого источника узкий яркий ореол и слабый широкий
////////////////////////////////////////////////////////////////////////////////

#include "slots.h"
#include "samplers.sh"
#include "bindless.sh"

DM_SRV( Texture2D<float4>, g_source, 0 );

// Раскладка — PostProcess::BloomParameters
cbuffer BloomBuffer : register( SLOT_CB_PASS )
{
	float2 g_sourceTexelSize;	// 1 / размер источника
	float  g_threshold;			// Bloom Threshold, яркость после экспозиции; < 0 — без порога
	int    g_firstPass;			// 1 — источник — цвет сцены
	float  g_radius;			// для увеличения: радиус тента в текселях источника
	float  g_weight;			// для увеличения: вес добавляемого уровня
	float2 g_padding;
};

struct PixelInputType
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
};

float3 sampleSource( float2 uv, float2 offset )
{
	return g_source.SampleLevel( g_SamplerLinearClamp, uv + offset * g_sourceTexelSize * g_radius, 0.0f ).rgb;
}

float4 main( PixelInputType input ) : SV_TARGET
{
	// Веса тента 1 2 1 / 2 4 2 / 1 2 1, сумма 16
	float3 result = sampleSource( input.uv, float2( 0.0f, 0.0f ) ) * 4.0f;
	result += ( sampleSource( input.uv, float2( -1.0f, 0.0f ) ) + sampleSource( input.uv, float2( 1.0f, 0.0f ) ) +
				sampleSource( input.uv, float2( 0.0f, -1.0f ) ) + sampleSource( input.uv, float2( 0.0f, 1.0f ) ) ) * 2.0f;
	result += sampleSource( input.uv, float2( -1.0f, -1.0f ) ) + sampleSource( input.uv, float2( 1.0f, -1.0f ) ) +
			  sampleSource( input.uv, float2( -1.0f, 1.0f ) ) + sampleSource( input.uv, float2( 1.0f, 1.0f ) );
	return float4( result / 16.0f * g_weight, 1.0f );
}
