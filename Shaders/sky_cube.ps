////////////////////////////////////////////////////////////////////////////////
// Грань cubemap неба (g_face) для освещения окружением: яркость неба в направлении каждого текселя — из таблицы
// Sky-View и земля под горизонтом (skyLuminance, Shaders/sky_view.sh). Класс SkyAtmosphere
////////////////////////////////////////////////////////////////////////////////

#define ATMOSPHERE_NO_SKY
#include "sky_view.sh"

struct PixelInputType
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
};

float4 main( PixelInputType input ) : SV_TARGET
{
	return float4( skyLuminance( cubeDirection( g_face, input.uv ) ), 1.0f );
}
