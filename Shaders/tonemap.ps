////////////////////////////////////////////////////////////////////////////////
// Последний проход цепочки: цвет сцены + bloom + лучи-звёзды + лучи солнца, экспозиция, ночное зрение, затем цветокоррекция
// и тонмаппинг — одной выборкой таблицы (color_grading_lut.cs): линейный HDR → задний буфер
// (R8G8B8A8_UNORM_SRGB кодирует sRGB сам).
// Класс PostProcess, настройки — строка PostProcessSettings уровня
////////////////////////////////////////////////////////////////////////////////

#include "slots.h"
#include "samplers.sh"
#include "exposure.sh"
#include "bindless.sh"
#include "color_grading.sh"

DM_SRV( Texture2D<float4>, g_sceneColor, 0 );
DM_SRV( Texture2D<float4>, g_bloom, 1 );	// самый крупный уровень bloom (половина кадра), уже с добавленными меньшими
DM_SRV( Texture2D<float4>, g_star, 2 );		// лучи-звёзды вокруг ярких бликов (четверть кадра, star_streak.ps)
DM_SRV( Texture2D<float4>, g_shafts, 3 );	// лучи солнца (четверть кадра, light_shaft_blur.ps)
DM_SRV( Texture2D<float>, g_depth, 4 );		// глубина сцены (обратная: 0 — небо) — доля лучей перед ближним
DM_SRV( Texture3D<float4>, g_colorGrading, 5 );	// цветокоррекция и тонмаппинг: цвет экрана в кодировке sRGB (color_grading.sh)

#include "tonemap_constants.h"

struct PixelInputType
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
};

// Ночное зрение — сдвиг Пуркинье (G. Krawczyk, K. Myszkowski, H.-P. Seidel, «Perceptual effects in real-time tone
// mapping», 2005, по R. Hunt, 1995): в темноте работают палочки, и цвет уходит в монохромный с синеватым оттенком.
// Доля палочек s(Y) = 0,04 / (0,04 + Y), Y — яркость пикселя, кд/м²: колбочки слабеют от ~3 кд/м² и почти не видят
// ниже ~0,03 (склон в полнолуние — s ≈ 0,6, ночное небо — ≈ 1). Яркость сохраняется: замер экспозиции не меняется
static const float3 scotopicTint = float3( 1.05f, 0.97f, 1.27f );

float3 purkinjeShift( float3 color )
{
	const float luminance = dot( color, float3( 0.2126f, 0.7152f, 0.0722f ) );
	const float physical = luminance / max( currentExposure(), 1e-30f );
	const float rods = 0.04f / ( 0.04f + physical ) * g_purkinjeShift;
	return lerp( color, scotopicTint * luminance, rods );
}

// Экспозиция, ночное зрение, цветокоррекция и тонмаппинг: линейный HDR с экспозицией прошлого кадра → цвет экрана
float3 finishColor( float3 color )
{
	// Буфер сцены — с экспозицией прошлого кадра, приводим к новой (Shaders/exposure.sh)
	color *= exposureRatio();
	[branch] if( g_purkinjeShift > 0.0f )
		color = purkinjeShift( color );

	// Таблица хранит цвет экрана в кодировке sRGB; задний буфер ждёт линейное значение
	const float3 screen = g_colorGrading.SampleLevel( g_SamplerLinearClamp, colorGradingCoordinate( color ), 0.0f ).rgb;
	return sRGBToLinear( screen );
}

float4 main( PixelInputType input ) : SV_TARGET
{
	float3 color = g_sceneColor.Load( int3( input.position.xy, 0 ) ).rgb;
	// Отладочный вид «Light shafts»: сам след лучей солнца (до доли воздуха) с экспозицией кадра
	[branch] if( g_showShafts > 0.0f )
		return float4( finishColor( g_shafts.SampleLevel( g_SamplerLinearClamp, input.uv, 0.0f ).rgb * g_shaftColor ), 1.0f );
	[branch] if( g_bloomScale > 0.0f )
		color += g_bloom.SampleLevel( g_SamplerLinearClamp, input.uv, 0.0f ).rgb * g_bloomScale;
	[branch] if( any( g_shaftColor > 0.0f ) )
	{
		// Лучи — свет, рассеянный в воздухе перед тем, что за пикселем: перед веткой у камеры воздуха почти нет — нет и дымки
		// (без этого экранный след светил поверх всего ближнего); небо — полная доля
		const float depth = g_depth.Load( int3( input.position.xy, 0 ) );
		const float viewZ = depth > 0.0f ? g_depthLinearize.y / ( depth - g_depthLinearize.x ) : 1e9f;
		const float air = g_shaftInverseDistance > 0.0f ? 1.0f - exp( -viewZ * g_shaftInverseDistance ) : 1.0f;
		color += g_shafts.SampleLevel( g_SamplerLinearClamp, input.uv, 0.0f ).rgb * g_shaftColor * air;
	}
	// Звёзды: с прозрачностью — кадр с ними и без них смешиваются уже после тонмаппинга: звезда та же по размеру и форме,
	// меняется только её видимость (сила g_starScale меняет яркость, а с ней и то, насколько длинными кажутся лучи)
	[branch] if( g_starScale > 0.0f )
	{
		const float3 star = g_star.SampleLevel( g_SamplerLinearClamp, input.uv, 0.0f ).rgb * g_starScale;
		[branch] if( g_starOpacity >= 1.0f )
			return float4( finishColor( color + star ), 1.0f );
		return float4( lerp( finishColor( color ), finishColor( color + star ), g_starOpacity ), 1.0f );
	}
	return float4( finishColor( color ), 1.0f );
}
