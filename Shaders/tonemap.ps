////////////////////////////////////////////////////////////////////////////////
// Последний проход цепочки: цвет сцены + bloom, экспозиция и тонмаппинг: линейный HDR → задний буфер
// (R8G8B8A8_UNORM_SRGB кодирует sRGB сам).
// Класс PostProcess, настройки — строка PostProcessSettings уровня
////////////////////////////////////////////////////////////////////////////////

#include "slots.h"
#include "samplers.sh"

Texture2D<float4> g_sceneColor : register(t0);
Texture2D<float4> g_bloom : register(t1);	// самый крупный уровень bloom (половина кадра), уже с добавленными меньшими

// Раскладка — PostProcess::Parameters
cbuffer PostProcessBuffer : register( SLOT_CB_PASS )
{
	float g_exposure;	// 2^EV
	int   g_tonemapper;	// 0 — без тонмаппинга, 1 — ACES, 2 — AgX
	float g_bloomScale;	// Bloom Intensity / сумма весов уровней: уровень хранит взвешенную сумму всех уровней
	float g_padding;
};

struct PixelInputType
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
};

// ACES: подгонка RRT + ODT (Stephen Hill, BakingLab, лицензия MIT). Вход и выход — линейный sRGB
static const float3x3 acesInput =
{
	0.59719f, 0.35458f, 0.04823f,
	0.07600f, 0.90834f, 0.01566f,
	0.02840f, 0.13383f, 0.83777f
};

static const float3x3 acesOutput =
{
	 1.60475f, -0.53108f, -0.07367f,
	-0.10208f,  1.10813f, -0.00605f,
	-0.00327f, -0.07276f,  1.07602f
};

float3 acesFitted( float3 color )
{
	color = mul( acesInput, color );
	float3 a = color * ( color + 0.0245786f ) - 0.000090537f;
	float3 b = color * ( 0.983729f * color + 0.4329510f ) + 0.238081f;
	return saturate( mul( acesOutput, a / b ) );
}

// AgX: приближение отображения Blender 4+ (Benjamin Wrensch, «Minimal AgX», лицензия MIT): вход в «рабочее»
// пространство AgX, логарифм в диапазоне 16,5 EV, сигмоида полиномом, обратная матрица и гамма дисплея 2,2
static const float3x3 agxInset =
{
	0.842479062253094f, 0.0784335999999992f, 0.0792237451477643f,
	0.0423282422610123f, 0.878468636469772f, 0.0791661274605434f,
	0.0423756549057051f, 0.0784336f, 0.879142973793104f
};

static const float3x3 agxOutset =
{
	 1.19687900512017f, -0.0980208811401368f, -0.0990297440797205f,
	-0.0528968517574562f, 1.15190312990417f, -0.0989611768448433f,
	-0.0529716355144438f, -0.0980434501171241f, 1.15107367264116f
};

float3 agxContrast( float3 x )
{
	float3 x2 = x * x;
	float3 x4 = x2 * x2;
	return 15.5f * x4 * x2 - 40.14f * x4 * x + 31.96f * x4 - 6.868f * x2 * x + 0.4298f * x2 + 0.1191f * x - 0.00232f;
}

float3 agx( float3 color )
{
	const float minEv = -12.47393f;
	const float maxEv = 4.026069f;

	color = mul( agxInset, max( color, 1e-10f ) );
	color = ( clamp( log2( color ), minEv, maxEv ) - minEv ) / ( maxEv - minEv );
	color = agxContrast( color );
	color = mul( agxOutset, color );
	// Результат закодирован для дисплея с гаммой 2,2; задний буфер sRGB ждёт линейное значение
	return pow( saturate( color ), 2.2f );
}

float4 main( PixelInputType input ) : SV_TARGET
{
	float3 color = g_sceneColor.Load( int3( input.position.xy, 0 ) ).rgb;
	[branch] if( g_bloomScale > 0.0f )
		color += g_bloom.SampleLevel( g_SamplerLinearClamp, input.uv, 0.0f ).rgb * g_bloomScale;
	color *= g_exposure;

	[branch] if( g_tonemapper == 1 )
		color = acesFitted( color );
	else if( g_tonemapper == 2 )
		color = agx( color );
	else
		color = saturate( color );

	return float4( color, 1.0f );
}
