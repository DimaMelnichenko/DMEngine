////////////////////////////////////////////////////////////////////////////////
// Переход освещения окружением от прежнего результата SkyLight к новому: грань g_face мипа g_mip префильтра отражений —
// смесь двух cubemap с долей g_blend. Пересчёт идёт по шагу за кадр, и без перехода при быстром времени суток свет
// менялся бы ступеньками раз в SkyLight::captureSteps + 1 кадров. Класс SkyLight
////////////////////////////////////////////////////////////////////////////////

#include "slots.h"
#include "samplers.sh"
#include "cubemap.sh"

// Раскладка — SkyLight::BlendParameters
cbuffer BlendParameters : register( SLOT_CB_PASS )
{
	int   g_face;
	float g_mip;
	float g_blend;		// 0 — прежний результат, 1 — новый
	float g_blendPadding;
};

TextureCube g_previous : register( t0 );
TextureCube g_current : register( t1 );

struct PixelInputType
{
	float4 position : SV_POSITION;
	float2 uv : TEXCOORD0;
};

float4 main( PixelInputType input ) : SV_TARGET
{
	// Направление через центр текселя цели, выборка без фильтрации — ровно тот же тексель обоих cubemap
	const float3 n = cubeDirection( g_face, input.uv );
	const float4 previous = g_previous.SampleLevel( g_SamplerPointClamp, n, g_mip );
	const float4 current = g_current.SampleLevel( g_SamplerPointClamp, n, g_mip );
	return lerp( previous, current, g_blend );
}
