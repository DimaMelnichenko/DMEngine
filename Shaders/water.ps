////////////////////////////////////////////////////////////////////////////////
// Поверхность воды на сетке симуляции — озёра и вода, которая течёт по рельефу (класс WaterSimulation, docs/water.md).
// Материал — Shaders/water_shading.sh; здесь — вода из текстуры симуляции (режим static — одно поле озёр и ручьёв):
// течение; пена — поле пены статичной воды (WaterFoam, water_foam.cs: быстрая вода, сдвиг, слив — и перенос течением;
// без поля, в режиме simulated, — по скорости и сдвигу в пикселе) и у камней русла, которые выходят к поверхности; глубина
// — до сцены под поверхностью
////////////////////////////////////////////////////////////////////////////////

#include "water_shading.sh"
#include "water_clip.sh"
#include "water.sh"
#include "bindless.sh"

DM_SRV( Texture2D<float2>, g_stones, 2 );	// камни русла: площадь поперёк потока на м² дна клетки (WaterSimulation)
DM_SRV( Texture2D, g_groundHeightMap, 3 );	// итоговая карта высот, нормированная (TerrainPipeline) — точная земля для уреза
DM_SRV( Texture2D<float>, g_foamCoarse, 5 );			// поле пены сетки 1 м (WaterFoam), если g_foamField
DM_SRV( Texture2DArray<float>, g_foamDetail, 6 );	// поле пены детальной воды — тексели и срезы g_waterDetail

// Высота точной земли в точке: детальная плитка у русла или карта высот — как sampleFineHeight у террейна. Урез по ней, а
// не по нарисованному рельефу: вдали он грубее, и галька дна с мокрой землёй (по точной земле) разошлись бы с краем воды
float groundHeight( float2 worldXZ, float2 uv )
{
	float detail;
	const float normalized = sampleTerrainDetail( worldXZ, g_terrainDetailTile, detail ) ? detail :
							 g_groundHeightMap.SampleLevel( g_SamplerLinearClamp, uv, 0.0f ).r;
	return normalized * g_terrainHeightMultiplier + g_terrainHeightOffset;
}

// Без поля пены (режим simulated) — пена у камня в пикселе: вода тоньше этого над тем, что в клетке с камнями (камень
// выходит к поверхности или чуть под ней), м; площадь камней клетки, при которой пена полная (камень 0,4 м, погружённый на
// 0,2 м, — 0,08). С полем пена у камней — в нём (water_foam.cs: по верху камня и уровню воды, хвост — по течению)
static const float stoneFoamDepth = 0.12f;
static const float stoneFoamArea = 0.08f;
// Глубина по лучу взгляда — пока он упирается не дальше этого от точки по горизонтали, м; дальше — до точной земли под точкой
static const float rayDepthReach = 0.3f;

float4 main( WaterPixelInput input ) : SV_TARGET
{
	clipWaterSurface( input );
	float3 detailTexel;
	const bool detail = waterDetailTexel( input.uv, detailTexel );
	const WaterSample water = sampleWater( input.uv, detail, detailTexel );
	const float speed = length( water.velocity );

	// Глубина в пикселе — до точной земли под точкой (детальная плитка у русел или карта высот), а рядом с тем, что в воде
	// (камень), — до сцены за поверхностью по лучу взгляда (глубина сцены): кромка и пена у камня
	const float surfaceViewZ = max( mul( float4( input.worldPosition, 1.0f ), cb_viewMatrix ).z, 1e-3f );
	const float behindViewZ = sceneViewDepthAt( input.position );
	const float3 behind = cb_cameraPosition + ( input.worldPosition - cb_cameraPosition ) * ( behindViewZ / surfaceViewZ );

	WaterShading shading;
	shading.position = input.position;
	shading.worldPosition = input.worldPosition;
	shading.normal = input.normal;
	shading.velocity = water.velocity;
	// Урез — по точной земле: где нарисованный вдали рельеф ушёл под плоскость воды, а точная земля суше, воды нет (кромка
	// гаснет, как у уреза). По лучу — только если он упёрся рядом с точкой по горизонтали: у плоского дна спуск луча до него
	// и есть глубина, но вскользь луч уходит далеко и упирается в подъём дна (следующую ступень лесенки, борт), едва
	// опустившись, — глубина выходила в сантиметры, и пена, отражение и рассеяние гасли, как у уреза (Dimok, 2026-10-16: на
	// лесенке уступов вдали пены нет, а с высоты есть)
	const float groundDepth = max( input.worldPosition.y - groundHeight( input.worldPosition.xz, input.uv ), 0.0f );
	const float rayDepth = max( input.worldPosition.y - behind.y, 0.0f );
	const float rayReach = length( behind.xz - input.worldPosition.xz );
	shading.depth = min( groundDepth, lerp( rayDepth, groundDepth, saturate( rayReach / rayDepthReach ) ) );
	// Текущая вода (ручей) неспокойна и на пологом: рябь течения не слабее 0,7 уже при 0,3 м/с; озеро — по скорости
	shading.ripple = 0.7f * saturate( speed / 0.3f );
	shading.detailTexel = detailTexel;
	shading.detailRipple = detail ? detailRippleWeight( input.worldPosition.xz ) : 0.0f;
	shading.nearRipple = detail ? nearWaterWeight( input.worldPosition.xz ) : 0.0f;
	float foam;
	if( g_foamField > 0.0f )
	{
		// Поле пены (посчитано при загрузке): у русел — детальное, к краю набора плиток — переход в сетку 1 м, как у ряби
		foam = g_foamCoarse.SampleLevel( g_SamplerLinearClamp, input.uv, 0.0f );
		if( detail )
		{
			uint width, height, slices;
			g_foamDetail.GetDimensions( width, height, slices );
			const float fine = g_foamDetail.SampleLevel( g_SamplerLinearClamp, float3( detailTexel.xy / float2( width, height ), detailTexel.z ), 0.0f );
			foam = lerp( foam, fine, shading.detailRipple );
		}
	}
	else
	{
		// Без поля (режим simulated: течение меняется каждый кадр) — быстрая вода и сдвиг скорости между соседними клетками по
		// обе стороны, на 2 м
		const float texel = 1.0f / g_size;
		const float2 dx = sampleWater( input.uv + float2( texel, 0.0f ) ).velocity - sampleWater( input.uv - float2( texel, 0.0f ) ).velocity;
		const float2 dz = sampleWater( input.uv + float2( 0.0f, texel ) ).velocity - sampleWater( input.uv - float2( 0.0f, texel ) ).velocity;
		const float shear = ( length( dx ) + length( dz ) ) / ( 2.0f * g_cellSize );
		foam = saturate( ( speed - g_foamSpeed ) / g_foamSpeed ) + saturate( shear / g_foamShear - 0.5f );
		// У камня, выходящего к поверхности, вода бурлит: кромка пены, где слой воды над ним тонкий, — сильнее на быстрой воде
		const float stones = saturate( g_stones.SampleLevel( g_SamplerLinearClamp, input.uv, 0.0f ).x / stoneFoamArea );
		foam += stones * saturate( 1.0f - shading.depth / stoneFoamDepth ) * saturate( speed / 0.5f );
	}
	shading.foam = foam;
	return shadeWater( shading );
}
