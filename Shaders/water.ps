////////////////////////////////////////////////////////////////////////////////
// Поверхность воды на сетке симуляции — озёра и вода, которая течёт по рельефу (класс WaterSimulation, docs/water.md).
// Материал — Shaders/water_shading.sh; здесь — вода из текстуры симуляции (режим static — одно поле озёр и ручьёв):
// течение и пена по скорости и сдвигу скорости между соседними ячейками (перекаты, у камней, слив из озера; у русел — по
// ячейкам детальной воды 0,25 м) и у камней русла, которые выходят к поверхности; глубина — до сцены под поверхностью
////////////////////////////////////////////////////////////////////////////////

#include "water_shading.sh"
#include "water.sh"
#include "bindless.sh"

DM_SRV( Texture2D<float2>, g_stones, 2 );	// камни русла: площадь поперёк потока на м² дна клетки (WaterSimulation)

// Пена у камня: вода тоньше этого над тем, что в клетке с камнями (камень выходит к поверхности или чуть под ней), м;
// площадь камней клетки, при которой пена полная (камень 0,4 м, погружённый на 0,2 м, — 0,08)
static const float stoneFoamDepth = 0.12f;
static const float stoneFoamArea = 0.08f;

float4 main( WaterPixelInput input ) : SV_TARGET
{
	const float tileSize = WATER_TILE * g_cellSize;
#ifdef WATER_DETAIL
	// Детальная плитка рисует только свою площадь: поле в тексель с каждой стороны — у соседней плитки
	const float2 local = input.worldPosition.xz / tileSize - waterDetailTile( input.tile );
	if( any( local < 0.0f ) || any( local >= 1.0f ) )
		discard;
#else
	// Где поверхность рисует детальная плитка (у русел, вблизи камеры), грубой нет — то же правило, что у отбора тайлов
	if( g_detailDistance > 0.0f )
	{
		const int2 detailTile = int2( floor( input.worldPosition.xz / tileSize ) );
		uint tilesX, tilesZ;
		g_terrainDetailIndex.GetDimensions( tilesX, tilesZ );
		if( all( detailTile >= 0 ) && detailTile.x < (int)tilesX && detailTile.y < (int)tilesZ &&
			waterDetailRendered( detailTile, g_terrainDetailIndex.Load( int3( detailTile, 0 ) ), cb_cameraPosition ) )
			discard;
	}
#endif
	float3 detailTexel;
	const bool detail = waterDetailTexel( input.uv, detailTexel );
	const WaterSample water = sampleWater( input.uv, detail, detailTexel );
	const float speed = length( water.velocity );
	// Сдвиг скорости — скачок между соседними ячейками по обе стороны, на 2 м: у сетки 1 м — градиент, у детальной воды
	// (соседи 0,25 м) — тот же скачок, но резкий: у камня, на струе между камнями. Градиент на 0,25 м круче (профиль поперёк
	// узкого ручья — 1 м/с на 30–40 см), и пена с тем же порогом шла бы по всему ручью
	float2 dx, dz;
	if( detail )
	{
		uint width, height, slices;
		g_waterDetail.GetDimensions( width, height, slices );
		const float2 size = float2( width, height );
		dx = g_waterDetail.SampleLevel( g_SamplerLinearClamp, float3( ( detailTexel.xy + float2( 1.0f, 0.0f ) ) / size, detailTexel.z ), 0.0f ).yz -
			 g_waterDetail.SampleLevel( g_SamplerLinearClamp, float3( ( detailTexel.xy - float2( 1.0f, 0.0f ) ) / size, detailTexel.z ), 0.0f ).yz;
		dz = g_waterDetail.SampleLevel( g_SamplerLinearClamp, float3( ( detailTexel.xy + float2( 0.0f, 1.0f ) ) / size, detailTexel.z ), 0.0f ).yz -
			 g_waterDetail.SampleLevel( g_SamplerLinearClamp, float3( ( detailTexel.xy - float2( 0.0f, 1.0f ) ) / size, detailTexel.z ), 0.0f ).yz;
	}
	else
	{
		const float texel = 1.0f / g_size;
		dx = sampleWater( input.uv + float2( texel, 0.0f ) ).velocity - sampleWater( input.uv - float2( texel, 0.0f ) ).velocity;
		dz = sampleWater( input.uv + float2( 0.0f, texel ) ).velocity - sampleWater( input.uv - float2( 0.0f, texel ) ).velocity;
	}
	const float shear = ( length( dx ) + length( dz ) ) / ( 2.0f * g_cellSize );

	// Глубина в пикселе — от поверхности до сцены под ней по вертикали (глубина сцены), а не по сетке 1 м: урез по земле,
	// которую видно (детальная земля у русел — U-ложе), плавный
	const float surfaceViewZ = max( mul( float4( input.worldPosition, 1.0f ), cb_viewMatrix ).z, 1e-3f );
	const float behindViewZ = sceneViewDepthAt( input.position );
	const float3 behind = cb_cameraPosition + ( input.worldPosition - cb_cameraPosition ) * ( behindViewZ / surfaceViewZ );

	WaterShading shading;
	shading.position = input.position;
	shading.worldPosition = input.worldPosition;
	shading.normal = input.normal;
	shading.velocity = water.velocity;
	shading.depth = max( input.worldPosition.y - behind.y, 0.0f );
	// Текущая вода (ручей) неспокойна и на пологом: рябь течения не слабее 0,7 уже при 0,3 м/с; озеро — по скорости
	shading.ripple = 0.7f * saturate( speed / 0.3f );
	shading.detailTexel = detailTexel;
	shading.detailRipple = detail ? detailRippleWeight( input.worldPosition.xz ) : 0.0f;
	// У камня, выходящего к поверхности, вода бурлит: кромка пены, где слой воды над ним тонкий, — сильнее на быстрой воде
	const float stones = saturate( g_stones.SampleLevel( g_SamplerLinearClamp, input.uv, 0.0f ).x / stoneFoamArea );
	const float contact = stones * saturate( 1.0f - shading.depth / stoneFoamDepth ) * saturate( speed / 0.5f );
	shading.foam = saturate( ( speed - g_foamSpeed ) / g_foamSpeed ) + saturate( shear / g_foamShear - 0.5f ) + contact;
	return shadeWater( shading );
}
